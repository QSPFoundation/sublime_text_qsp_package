%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html
#
# Quest Soft Player Language:
# https://qsp.org/
#
# Формат qsrc: ОДИН ФАЙЛ = ОДНА ЛОКАЦИЯ.
#   - начало локации = начало файла, конец локации = конец файла;
#   - весь файл подсвечивается как тело локации;
#   - текста «между локациями» здесь нет;
#   - конструкции, похожие на qsps-границы (`# …` / `-- …`), подсвечиваются
#     как САМОСТОЯТЕЛЬНЫЕ statements, но НЕ открывают/не закрывают блок;
#     маркеры — строго колонка 0, конец — только `--` (аудит п.12: grammar
#     `endLocMarker = "--"`, как в qsps; прежний одиночный `-` в колонке 0 —
#     это код, например строка-продолжение `-2`, а не конец локации);
#   - заголовок `!@ QSP-Game …` (если есть) — обычный комментарий.
# Подсветка кода тела общая с форматом qsps — вынесена в базу
# `qsp_base.sublime-syntax` и подключена через `extends`.

name: QSP-Loc # название языка
# `source.qsp.qsrc`: селекторы матчатся по префиксу сегментов, поэтому
# `source.qsp` (правила/темы qsps) действует и на `.qsrc`. Прежнее имя
# `source.qsrc.qsp` имело обратный порядок и родителем считалось `source.qsrc`.
scope: source.qsp.qsrc
version: 2
extends: qsp_base.sublime-syntax
file_extensions: # расширения файлов (группа qsrc)
  - qsrc

contexts:
  main: # весь файл — тело одной локации
    # Аудит п.25: `- include: qspdocs` отсюда УБРАН. Doc-строка `!@ #… - …` теперь
    # трактуется так же, как в ТЕЛЕ локации формата qsps, — обычный спец-комментарий
    # (`avs_speccomments`, п.30), а не `meta.gametext`-документация. Единый инвариант:
    # doc-форматирование `qspdocs` живёт ТОЛЬКО в тексте между локациями qsps (`diff`),
    # где scope `meta.gametext`/`meta.diff` семантически верен (это игнорируемый текст).
    # В qsrc между-локационного текста нет, поэтому любое `!@ #…` — строка ТЕЛА локации
    # → уходит в `location_body` (головка комментария `!` + детектор `!@`). Раньше
    # включение `qspdocs` здесь давало РАЗНУЮ подсветку одного и того же constructs
    # в двух форматах (qsps-тело = спец-комментарий, qsrc = doc-строка).
    # qsps-подобные границы локации → самостоятельные statements (без push-блока).
    # Оба маркера — строго колонка 0 (инвариант границ локаций, аудит п.11/п.12;
    # прежде `^\s*?` допускал отступ — расхождение с qsps).
    - match: ^(#)\s?.+$
      scope: constant.character.qsp avs_locstart
    # Аудит п.12: конец локации — ТОЛЬКО `--` (grammar `endLocMarker = "--"`,
    # как в qsps `^(--)(.*?)$`). БЫЛО `^\s*?(-)`: одиночный `-` в колонке 0
    # (строка-продолжение выражения `-2`) красился как конец локации. Теперь
    # одиночный `-` — обычный код: правило его не матчит, строка уходит в
    # location_body (унарный оператор keyword.operator.one-sign), отдельное
    # invalid-правило НЕ нужно — `-` легален в выражениях.
    - match: ^(--)(.*?)$
      captures:
        1: variable.parameter.url.qsp avs_locend
        2: entity.name.function entity.name avs_locend_comments
    # остальное — код тела локации (из базы)
    - include: location_body
    # Одиночная `}` вне открытого `{` — ошибка (см. комментарий в qsp.sublime-syntax:
    # внутри `{…}` её ловит push figure_brace, поэтому правило только тут).
    - match: '\}'
      scope: invalid.illegal.qsp avs_wrong_closed_brace
