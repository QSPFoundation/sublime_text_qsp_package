! допускался у обоих маркеров. Маркеры — строго колонка 0 (инвариант границ, п.11).
-2
// <- keyword.operator.one-sign.qsp -avs_locend
  # было с отступом — не маркер начала
//^ -avs_locstart
# маркер начала в колонке 0
