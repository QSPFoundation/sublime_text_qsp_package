  # Запятая (P1.6): правило «без правого операнда» и сам разделитель построчно
  # идентичны в operacion и operacion_subex. with_out_left у них РАЗНЫЙ, поэтому
  # одним блоком запятые не вынести (порядок значим: with_out_right → with_out_left
  # → разделитель) — вынесены два независимых сегмента.
  operacion_comma_with_out_right:
