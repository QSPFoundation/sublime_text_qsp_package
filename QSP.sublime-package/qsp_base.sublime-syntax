%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html
#
# Quest Soft Player Language: ОБЩАЯ БАЗА подсветки тела локации.
# https://qsp.org/
#
# Этот файл — общий каркас (hidden). Его наследуют через `extends`:
#   - qsp.sublime-syntax        (формат qsps: блоки локаций + текст между ними)
#   - qsp.qsrc.sublime-syntax   (формат qsrc: один файл = одна локация)
# В базе живёт ВСЁ, что общее для форматов: подсветка кода тела локации.
# Разнятая у форматов логика (main, границы локации, текст между локациями,
# заголовок QSP-Game) — НЕ в базе, а в самих форматах.

name: QSP (base)
hidden: true
scope: source.qsp.base
version: 2

variables: # назначаем переменные для удобства
  kw_statements: |- # keyword.statement
    (?ix:
      inclib|freelib|openqst|opengame|savegame|
      addobj|delobj|killobj|modobj|resetobj|unsel|unselect|
      cls|
      cla|delact|
      cmdclr|cmdclear|
      play|close[ ]all|close|
      jump|dynamic|goto|gt|xgoto|xgt|gosub|gs|menu|exit|
      showobjs|showstat|showacts|showinput|refint|
      copyarr|sortarr|setvar|insvar|unpackarr|killvar|killall|scanstr|
      view|msg|
      settimer|wait|
      # exec: нет в qsp_grammar.peg, но движок поддерживает — в подсветке нужен, НЕ убирать.
      # close[ ]all: разделитель — ТОЛЬКО одиночный пробел (таб/прочие `\s` движок не
      # принимает). `[ ]` вместо «сырого» пробела, т.к. в extended-режиме `(?ix:` пробел
      # вне класса игнорируется. Это не `ws` из грамматики (в kw_elseif таб разрешён).
      exec
    )
  kw_controls: (?i:act|if|elseif|else|loop|while|step|end) # keyword.control
  kw_text_statements: (?i:pl?|nl|clr|clear) # keyword.statement
  system_vars_num: (?i:nosave|disablescroll|debug|usehtml|(b|f|l)color|fsize)
  system_vars_string: (?i:counter|ongload|ongsave|onnewloc|onactsel|onobjsel|onobjadd|onobjdel|usercom|fname|backimage)
  system_vars: (?i:args|result)
  functions_num: |- # variable.function
    (?ix:
      loc|obj|isnum|isplay|
      len|val|instr|strcomp|strpos|
      arrsize|arrpos|arrcomp|
      msecscount|
      rgb|
      countobj|
      ra?nd
    )
  functions_string: |- # variable.function
    (?ix:
      desc|user_text|usrtxt|maintxt|stattxt|
      curloc|selobj|selact|
      mid|(u|l)case|trim|replace|str|strfind|
      input|
      qspver|
      curacts|curobjs|
      getobj|
      arrtype|arrkey
    )
  functions_tuple: |- # variable.function
    (?ix:
      arrpack
    )
  functions_alltypes: (?i:iif|dyneval|func|max|min|arritem) # variable.function
  quote: '"'
  ap: "'"
  left_operand: '({{quote}}|{{ap}}|\)|\}|\$|\%|\?|\w|\d)'
  right_operand: '({{quote}}[^{{quote}}]*|{{ap}}[^{{ap}}]*|\([^\)]*?|\[[^\]]*?|\{|((\$|\%|\#)?|-?)\w+?|-?\d+?|\@|\?)'
  nr: (\n\r|\r|\r\n|\n)
  nr_lookahead: (?=\r\n|\r|\n|$)
  # «в заголовке есть незакрытая на этой строке ( или [» — признак многострочной
  # скобки, из-за которой ':' уезжает на другую строку. Закрытием занимается multiline_round.
  unbalanced_bracket_head: (?=[^\n]*?[\(\[](?![^\n]*?[\)\]])[^\n]*?{{nr_lookahead}})
  # намеренная реализация: двухзначные `=<`/`=>` (grammar `binaryStandardOperator`) не
  # поддержаны — ловим только `<= >= += -= *= /= <>`; `=<`/`=>` красятся как два one-sign'а.
  operacion_two_signs: ([<>\+\-\*\/]=|<>)
  operacion_one_sign: (\+|-|<|>|=|\/|\*|!)
  operacion_word: (?i:and|or|mod)
  # users_variables: имя = первый символ буква/`_`, далее Unicode-буквы, цифры, `_`, `.`
  # (grammar varName). Требует поддержки `\p{L}` в Onigmo.
  users_variables: '((\$|\%|\#)?[\p{L}_][\p{L}\d_.]*)'
  # sugar_name: имя процедуры/функции после `@`/`@@` — может быть кириллицей (grammar
  # `nonDelimiterChar+`, а `@` — сам разделитель). Класс как users_variables + `#`;
  # `$`/`%` в имя не входят. (`\w` был бы ASCII-only и не ловил кириллицу.)
  sugar_name: '[\p{L}\d_.\#]+'
  # `else[ \t]*if`: горизонтальный пробел/таб (не `\s`), как в kw_elseif.
  elseif_else_final: (?i:\bend\b|\belse\b|\belse[ \t]*if\b|\bif\b|(^\s*\-.*?$))
  # Общие фрагменты regex arms, используемы и в plain-, и в braced-контекстах.
  # NB: в значении есть ':' — кавычки YAML обязательны.
  arm_anchor: '(?:^|(?<=\{))(\s*?)'
  kw_act: '(?i:(act))'
  kw_if: '(?i:(\bif\b))'
  # `else if` — ЕДИНЫЙ оператор (grammar `elseIfMarker = "elseif" | "else" ws "if"`;
  # перенос строки в `ws` НЕ входит). Между словами — только горизонтальный `[ \t]+`
  # (grammar `space`), не `\s`. Матч Sublime построчный, `\n` в regex не попадает.
  kw_elseif: '(?i:(\b(?:else[ \t]+if|elseif)\b))'
  kw_loop: '(?i:(\bloop\b))'
  loop_strict_head: '(?=(?=.*?(?i:(\bwhile\b))\s\S.*?(?i:(\bstep\b))?\s*?.*?\:\s*?(!.*)?$))'
  loop_no_while: '(?!.*(?i:(\bwhile\b)))'
  # Решения pending-заголовков на видимом ':' и хвосты strict-arm'ов (все
  # lookahead-решения — нулевой ширины). «strict» — строгий хвост `!`, «soft» —
  # мягкий `!?` (act/else). Двоеточие в значениях — кавычки YAML обязательны.
  pend_block_strict: '(?=:\s*?(!.*)?$)'
  pend_block_soft: '(?=:\s*?(!.*?)?$)'
  pend_inline: '(?=:\s*\S)'
  act_strict_tail: '(?=\s*?.*?\:\s*?(!.*?)?$)'
  if_strict_tail: '(?=\s*?.*?\:\s*?(!.*)?$)'
  else_caret_tail: '(?=\s*\:\s*?(!.*?)?$)'
  else_brace_tail: '(?=\s*?.*?\:\s*?(!.*?)?$)'
  elseif_strict_tail: '(?=\s+\S.*?\:\s*(!.*)?$)'
  elseif_permissive_tail: '(?=\s+\S.*?\:\s*([^!\s].*)?$)'
  # final_guard: нулевой guard «строка началась с end/else/elseif/if/-» (pop делает правило).
  final_guard: '(?=^\s*{{elseif_else_final}}([^\&\n\r]*))'
  # kw_calls: список вызовов локаций; группа захватывающая (номера capture фиксированы).
  kw_calls: '(goto|gt|xgoto|xgt|gosub|gs)'
  # Левый контекст оператора: `\K`-версия (строки кода) и lookbehind-версия
  # (подвыражения `<< … >>` — там нет `^` строки). Захват сохранён.
  left_ctx_anchor: '(^\s*?|\&\s*?|\(\s*?|\{\s*?|\[\s*?)\K'
  left_ctx_lookbehind: '(?<=(<|\&|\(|\{|\[))'
  # lazy `\s*?` оставлен осознанно там, где greedy менял бы матч: `arm_anchor`
  # (квантор в конце — greedy съест отступ в scope), `left_ctx_anchor` (перед `\K`
  # — greedy сдвинет начало матча). В zero-width lookahead'ах (`pend_block_*`,
  # `*_strict_tail`, `loop_strict_head`) greedy/lazy на результат не влияет.

contexts: # общие контексты подсветки кода локации
  # Тривиальный вход для самой базы (база hidden, реально используется
  # только через extends из форматов qsps/qsrc, у которых свой main).
  main:
    - include: location_body

  # Тело локации — два формата (plain вне {…} и braced внутри {…}); общие include-
  # сегменты вынесены в body_common_*, форматы различаются лишь 4 позициями.
  body_common_head:
    - include: figure_brace
    - include: brackets_multiline
  body_common_mid:
    - include: kw_declarations
    - include: sugargosub
    - include: sugarfunc
    - include: wrong_end_else_elseif
    - include: preprocessor
  body_common_tail:
    - include: location_call
    - include: jump_to_label
    - include: labels
    - include: statements
    - include: operacion
    - include: system_variables
    - include: functions
    - include: numeric
    - include: strings
    - include: separator_continuation
    - include: users_variables
    # Пунктуация однострочных ( ) [ ] — ПОСЛЕДНИМ: anchor-правила operacion,
    # начинающиеся с '(' / '[', должны выигрывать.
    - include: brackets_inline

  location_body: # @braced: auto
    # Открыватели act/if/loop ИДУТ ПЕРЕД body_common_head, чтобы bracket-arm заголовка
    # не проиграл незакрытой «(» в brackets_multiline.
    - include: multiline_actions
    - include: multiline_conditions
    - include: multiline_loop
    - include: body_common_head
    - include: body_common_mid
    - include: comments
    - include: body_common_tail

  # Тело в {…} — location_body_braced: СГЕНЕРИРОВАНО (@begin-generated ниже).

  # Пользовательские переменные. `variable.other.qsp` — цветовая, `meta.user-variables.qsp`
  # — маркер группы. У invalid-правила цветовая scope отсутствует намеренно.
  users_variables:
    # `?` — литерал дефолтного значения (grammar `undefinedLiteral`), константа.
    - match: '\?'
      scope: constant.language.undefined.qsp
    - match: '{{users_variables}}(?=\s*\b(while|step|else|elseif|and|or|mod)\b)'
      scope: meta.user-variables.qsp variable.other.qsp
    - match: '{{users_variables}}(?=(\s+{{right_operand}}|\s*\({{right_operand}}))'
      scope: invalid.illegal.qsp meta.wrong_statement.qsp
    - match: '{{users_variables}}'
      scope: meta.user-variables.qsp variable.other.qsp

  # Прыжок на метку
  jump_to_label:
    - match: (jump)(?=\s*($|&))
      scope: invalid.illegal.qsp
    - match: (jump)\s*(('|").*?\3)
      captures:
        1: keyword.statement.qsp avs_statements
        2: string.quoted.double.qsp label_to_jump.qsp

  # вызовы локаций
  location_call:
    - match: '{{kw_calls}}(?=\s*($|&))'
      scope: invalid.illegal.qsp
    - match: '{{kw_calls}}\s*(({{ap}}|{{quote}}).*?\3)'
      captures:
        1: keyword.statement.qsp avs_statements
        2: string.quoted.double.qsp callable_locs.qsp
    - match: (func)(\()(('|").*?\4)
      captures:
        1: support.function.qsp
        3: string.quoted.double.qsp callable_locs.qsp

  # Имя — `{{sugar_name}}` (Unicode-буквы, цифры, `_`, `.`, `#`); `$`/`%` в имя не входят.
  sugargosub:
    - match: (\@\@)({{sugar_name}})
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp

  # неявный вызов функций
  sugarfunc:
    - match: (\@)({{sugar_name}})(?=\s*\()
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp markup.italic.qsp
    - match: (\@)({{sugar_name}})(?=\s*\b(while|step|else|elseif|and|or|mod)\b)
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp markup.italic.qsp
    - match: (\@{{sugar_name}}\s+{{right_operand}})
      scope: invalid.illegal.qsp markup.italic.qsp
    - match: (\@)({{sugar_name}})
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp markup.italic.qsp

  # Действия. Arms `(?<=\{)act` + `^act` слиты через non-capturing alternation
  # `(?:^|(?<=\{))` (оба нулевой ширины). Branch-reset `(?|…)` не поддерживается
  # этой сборкой Onigmo.
  # намеренная реализация: заголовок `act`/`if`/`elseif` БЕЗ `:` invalid'ом НЕ метится
  # (при наборе `:` ещё нет — красная заливка была бы ложной), хотя `loop` без `while`
  # метится (не станет валидным никогда).
  multiline_actions: # @braced: auto
    # strict-arm: ':' на строке act → сразу тело
    - match: '{{arm_anchor}}{{kw_act}}{{act_strict_tail}}'
      scope: meta.begin_action.qsp
      captures:
        2: keyword.control.action.begin.qsp markup.italic.qsp
      push: multiline_actions_body
    # bracket-arm: незакрытая ( или [ в заголовке → pending, решающий форму на ':'.
    - match: '{{arm_anchor}}{{kw_act}}{{unbalanced_bracket_head}}'
      scope: meta.begin_action.qsp
      captures:
        2: keyword.control.action.begin.qsp markup.italic.qsp
      push: multiline_act_pending

  # pending-заголовок act: состояние «до ':'» (механика — как multiline_if_pending).
  multiline_act_pending: # @braced: auto
    # Конец локации в незакрытом заголовке — ошибка + выход. Guard именно `--`
    # (wrongclose_locend), а не `-`: в заголовке перенос `step i +=` ⏎ `    -1:` легален.
    - include: wrongclose_locend
    - match: '{{pend_block_soft}}'
      pop: true
      push: multiline_actions_body
    - include: pending_inline_pop
    - include: location_body

  multiline_actions_body: # @braced: auto
    - include: comment_after_colon
    - match: ^(\s*)(?i:(\bend\b))
      scope: meta.end_action.qsp
      captures:
        2: keyword.control.action.end.qsp markup.italic.qsp
      pop: true
      push: comment_after_end_in_brace
    - include: wrongclose
    - include: wrong_close_in_brace
    - include: location_body

  # Циклы (arms `(?<=\{)loop` + `^loop` слиты; пуш-тело идентично)
  multiline_loop: # @braced: auto
    # strict-arm: ':' на строке loop → сразу тело
    - match: '{{arm_anchor}}{{kw_loop}}{{loop_strict_head}}'
      scope: meta.begin_cycle.qsp
      captures:
        2: keyword.control.cycle.begin.qsp markup.italic.qsp
      push: multiline_loop_body
    # bracket-arm: незакрытая ( или [ в заголовке loop → pre-while pending. Скобка
    # может стоять и ДО 'while' (grammar `loopMultiLine`), поэтому требование 'while'
    # проверяет сам pending, а не arm: блок открывается только если 'while' раньше ':'.
    - match: '{{arm_anchor}}{{kw_loop}}{{unbalanced_bracket_head}}'
      scope: meta.begin_cycle.qsp
      captures:
        2: keyword.control.cycle.begin.qsp markup.italic.qsp
      push: multiline_loop_pending_prewhile
    # invalid-arm: loop без 'while' и без незакрытой скобки — после всех валидных arm'ов.
    - match: '{{kw_loop}}{{loop_no_while}}'
      scope: invalid.illegal.qsp

  # Pending loop, состояние «while ещё не найден»: едет по скобке через location_body
  # и на первом 'while' переходит в multiline_loop_pending (нулевой ширины). Если ':'
  # раньше 'while' — заголовок битый, блок не открываем (end/else словит wrong_end_else_elseif).
  multiline_loop_pending_prewhile: # @braced: auto
    # Конец локации в незакрытом заголовке — ошибка + выход
    - include: wrongclose_locend
    - match: '(?=\b(?i:while)\b)'
      pop: true
      push: multiline_loop_pending
    - match: '{{pend_block_soft}}'
      pop: true
    - include: pending_inline_pop
    - include: location_body

  # pending-заголовок loop: состояние «до ':'» при уже найденном 'while'
  # (механика — как multiline_if_pending).
  multiline_loop_pending: # @braced: auto
    # Конец локации в незакрытом заголовке — ошибка + выход
    - include: wrongclose_locend
    - match: '{{pend_block_soft}}'
      pop: true
      push: multiline_loop_body
    - include: pending_inline_pop
    - include: location_body

  multiline_loop_body: # @braced: auto
    - include: comment_after_colon
    - match: ^(\s*)(?i:(\bend\b))
      captures:
        2: keyword.control.cycle.end.qsp markup.italic.qsp
      pop: true
      push: comment_after_end_in_brace
    - include: wrongclose
    - include: wrong_close_in_brace
    - include: location_body

  # Конструкции условий (arms `(?<=\{)if` + `^if` слиты)
  multiline_conditions: # @braced: auto
    # strict-arm: ':' на строке if → сразу тело
    - match: '{{arm_anchor}}{{kw_if}}{{if_strict_tail}}'
      scope: meta.begin_condition.qsp
      captures:
        2: keyword.control.conditional.begin.qsp markup.italic.qsp
      push: multiline_conditions_body
    # bracket-arm: незакрытая ( или [ в заголовке if — ':' уехал за пределы строки,
    # strict-arm не срабатывает. Пушим pending: он едет по скобке и решает форму
    # только на видимом ':'. Иначе однострочная форма с многострочной скобкой
    # (`…] = $arr: *pl …`) ложно открывала бы блок.
    - match: '{{arm_anchor}}{{kw_if}}{{unbalanced_bracket_head}}'
      scope: meta.begin_condition.qsp
      captures:
        2: keyword.control.conditional.begin.qsp markup.italic.qsp
      push: multiline_if_pending

  # pending-заголовок if: состояние «до ':'». Zero-width решения не съедают ':' —
  # его доедает либо тело (block), либо location_body (single-line), как в strict-arm.
  multiline_if_pending: # @braced: auto
    # Конец локации в незакрытом заголовке — ошибка + выход
    - include: wrongclose_locend
    # ':' и до конца строки только пробел/комментарий → блочная форма → то же тело,
    # что у strict-arm.
    - match: '{{pend_block_strict}}'
      pop: true
      push: multiline_conditions_body
    # ':' и на этой же строке утверждение → однострочная форма → блок НЕ открываем;
    # возвращаемся в location_body, а идущие следом else/end словит wrong_end_else_elseif.
    - include: pending_inline_pop
    - include: location_body

  # Тело if-конструкции (используют оба arm'а).
  multiline_conditions_body: # @braced: auto
    - include: comment_after_colon
    - match: ^(\s*)(?i:(\bend\b))
      captures:
        2: keyword.control.conditional.end.qsp markup.italic.qsp
      pop: true
      push: comment_after_end_in_brace
    - include: multiline_actions_elseif
    - include: multiline_actions_else
    - include: wrongclose
    - include: wrong_close_in_brace
    - include: location_body

  wrong_end_else_elseif:
    - match: (?i:(\bend\b)) # подсветка лишнего end'а
      scope: invalid.illegal.qsp meta.excess_end.qsp
    - match: ^(?:\s*)(?i:(\belse\b)) # лишний else
      scope: invalid.illegal.qsp meta.excess_else.qsp
    - match: ^(?:\s*)(?i:(\belseif\b)) # elseif работает только в многострочной форме (исправить, если изменится в 5.8.0)
      scope: invalid.illegal.qsp meta.excess_elseif.qsp

  # Ошибочные закрытия контейнеров: порядок «сначала ошибки, потом тело» (wrongclose →
  # wrong_close_in_brace → location_body). Правила ловят разные символы в непересекающихся
  # позициях, поэтому взаимный порядок на matching не влияет — но он единый везде.
  # wrongclose: «-» в начале строки внутри незакрытого act/loop/if — ложный признак конца локации.
  wrongclose:
    - match: ^\s*(-)(.*)({{nr}}$|$)
      scope: invalid.illegal.qsp
      pop: true

  # «Конец локации» (`--`) в незакрытой скобке `( `[ `{` — ошибка, как wrongclose:
  # строка красится invalid и закрывает один уровень. Нужны ИМЕННО два дефиса
  # (grammar `endLocMarker`), т.к. перенос с унарным минусом (`(1 +` ⏎ `    -2)`)
  # легален и ловится продолжением `^\s+(?=[+\-*\/<>=,&])` — guard стоит строго раньше.
  wrongclose_locend:
    - match: ^\s*(--)(.*?)({{nr}}$|$)
      scope: invalid.illegal.qsp
      pop: true

  # wrong_close_in_brace: «}» внутри незакрытой конструкции — ошибка и выход из контейнера.
  wrong_close_in_brace:
    - match: \}(.*)({{nr}}$|$)
      scope: invalid.illegal.qsp avs_error avs_wrongelse1
      pop: true

  # --- Общие include-сегменты тел else/elseif/pending ---
  # Построчно идентичные inline-тела push-стеков. Различие plain↔braced — только
  # в финальном include location_body/location_body_braced, поэтому сегменты без
  # суффикса _braced инклюдятся обоими зеркалами. Braced-зеркала генерирует gen_braced.py.
  pending_inline_pop:
    - match: '{{pend_inline}}'
