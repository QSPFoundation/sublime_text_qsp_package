%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html
#
# Quest Soft Player Language: ОБЩАЯ БАЗА подсветки тела локации.
# https://qsp.org/
#
# Этот файл — общий каркас (hidden). Его наследуют через `extends`:
#   - qsp.sublime-syntax        (формат qsps: блоки локаций + текст между ними)
#   - qsp.qsrc.sublime-syntax   (формат qsrc: один файл = одна локация)
# В базе живёт ВСЁ, что общее для форматов: подсветка кода тела локации.
# Разнятая у форматов логика (main, границы локации, текст между локациями,
# заголовок QSP-Game) — НЕ в базе, а в самих форматах.

name: QSP (base)
hidden: true
scope: source.qsp.base
version: 2

variables: # назначаем переменные для удобства
  kw_statements: |- # keyword.statement
    (?ix:
      inclib|freelib|openqst|opengame|savegame|
      addobj|delobj|killobj|modobj|resetobj|unsel|unselect|
      cls|
      cla|delact|
      cmdclr|cmdclear|
      play|close\sall|close|
      jump|dynamic|goto|gt|xgoto|xgt|gosub|gs|menu|exit|
      showobjs|showstat|showacts|showinput|refint|
      copyarr|sortarr|setvar|insvar|unpackarr|killvar|killall|scanstr|
      view|msg|
      settimer|wait|
      # exec: отсутствует в qsp_grammar.peg (упущение грамматики, не правим её),
      # но поддерживается движком и нужен в подсветке — НЕ убирать.
      exec
    )
  kw_controls: (?i:act|if|elseif|else|loop|while|step|end) # keyword.control
  kw_text_statements: (?i:pl?|nl|clr|clear) # keyword.statement
  system_vars_num: (?i:nosave|disablescroll|debug|usehtml|(b|f|l)color|fsize)
  system_vars_string: (?i:counter|ongload|ongsave|onnewloc|onactsel|onobjsel|onobjadd|onobjdel|usercom|fname|backimage)
  system_vars: (?i:args|result)
  functions_num: |- # variable.function
    (?ix:
      loc|obj|isnum|isplay|
      len|val|instr|strcomp|strpos|
      arrsize|arrpos|arrcomp|
      msecscount|
      rgb|
      countobj|
      ra?nd
    )
  functions_string: |- # variable.function
    (?ix:
      desc|user_text|usrtxt|maintxt|stattxt|
      curloc|selobj|selact|
      mid|(u|l)case|trim|replace|str|strfind|
      input|
      qspver|
      curacts|curobjs|
      getobj|
      arrtype|arrkey
    )
  functions_tuple: |- # variable.function
    (?ix:
      arrpack
    )
  functions_alltypes: (?i:iif|dyneval|func|max|min|arritem) # variable.function
  quote: '"'
  ap: "'"
  left_operand: '({{quote}}|{{ap}}|\)|\}|\$|\%|\?|\w|\d)'
  right_operand: '({{quote}}[^{{quote}}]*|{{ap}}[^{{ap}}]*|\([^\)]*?|\[[^\]]*?|\{|((\$|\%|\#)?|-?)\w+?|-?\d+?|\@|\?)'
  nr: (\n\r|\r|\r\n|\n)
  nr_lookahead: (?=\r\n|\r|\n|$)
  # Фаза 7: «в заголовке есть НЕзакрытая на этой строке ( или [ » — признак
  # многострочной скобки, из-за которой ':' уезжает на другую строку. Условие
  # требует наличия открывающей скобки, после которой на ЭТОЙ строке нет ни ')' ни ']'.
  # Закрытием такой скобки штатно занимается multiline_round.
  unbalanced_bracket_head: (?=[^\n]*?[\(\[](?![^\n]*?[\)\]])[^\n]*?{{nr_lookahead}})
  # NB (fidelity к qsp_grammar.peg, п.6.3): двухзначные операторы `=<` и `=>`
  # (grammar `binaryStandardOperator`) намеренно НЕ поддержаны — `operacion_two_signs`
  # ловит только `<= >= += -= *= /= <>`. `=<`/`=>` подсветятся как два one-sign'а.
  operacion_two_signs: ([<>\+\-\*\/]=|<>)
  operacion_one_sign: (\+|-|<|>|=|\/|\*|!)
  operacion_word: (?i:and|or|mod)
  # users_variables: имя переменной = все Unicode-буквы, цифры, подчёркивание и точка
  # (fidelity к grammar varName, п.6.7): первый символ — буква/`_` (не цифра, grammar
  # `~digit`), далее `\p{L}` (любая буква), `\d`, `_`, `.`. Прочие символы — нельзя.
  # NB: требует поддержки `\p{L}` в Onigmo Sublime — проверить ручным рендером.
  users_variables: '((\$|\%|\#)?[\p{L}_][\p{L}\d_.]*)'
  # sugar_name (аудит п.2): имя пользовательской процедуры/функции после `@`/`@@`.
  # grammar `userStatementName`/`userFunctionName = nonDelimiterChar+`, а `@` — сам
  # `delimiterChar`, т.е. имя МОЖЕТ быть кириллицей. Класс — как у `users_variables`:
  # Unicode-буквы (`\p{L}`), цифры, `_`, `.`, `#` (`$`/`%` в имя не входят).
  # БЫЛО `[\w\.\#]+`: `\w` в Onigmo — ASCII, поэтому `@Функция(1)`/`@@Процедура(2)`
  # не подсвечивались (всего 4 случая в корпусе `_examples`).
  sugar_name: '[\p{L}\d_.\#]+'
  elseif_else_final: (?i:\bend\b|\belse\b|\belse\s*if\b|\bif\b|(^\s*\-.*?$))
  # Шаг 1 рефакторинга (REFACTORING_REVIEW P1.1): общие фрагменты regex arms,
  # вынесены 1:1 (побайтовые копии заменяемых кусков — поведение не меняется).
  # Используются и в plain-, и в braced-контекстах (правки — зеркально).
  # NB: в значении есть ':' — кавычки YAML обязательны.
  arm_anchor: '(?:^|(?<=\{))(\s*?)'
  kw_act: '(?i:(act))'
  kw_if: '(?i:(\bif\b))'
  # `else if` — ЕДИНЫЙ оператор (grammar `elseIfMarker = "elseif" | "else" ws "if"`,
  # `ws = (lineContinuation | space)*` — ПЕРЕНОС строки в `ws` НЕ входит).
  # Поэтому между `else` и `if` — только ГОРИЗОНТАЛЬНЫЙ `[ \t]+`: с `\s+` пара
  # склеивалась через `\n`, и легальный вложенный `if` в теле else
  # (`else` ⏎<TAB>`if …:`, см. _examples/.../add nocount object in purse.qsps)
  # красился как один elseif-токен.
  kw_elseif: '(?i:(\b(?:else[ \t]+if|elseif)\b))'
  kw_loop: '(?i:(\bloop\b))'
  loop_strict_head: '(?=(?=.*?(?i:(\bwhile\b))\s\S.*?(?i:(\bstep\b))?\s*?.*?\:\s*?(!.*)?$))'
  loop_no_while: '(?!.*(?i:(\bwhile\b)))'
  # Решения pending-заголовков на видимом ':' и хвосты strict-arm'ов (все
  # lookahead-решения — нулевой ширины). «strict» — строгий хвост `!`, «soft» —
  # мягкий `!?` (act/else). Двоеточие в значениях — кавычки YAML обязательны.
  pend_block_strict: '(?=:\s*?(!.*)?$)'
  pend_block_soft: '(?=:\s*?(!.*?)?$)'
  pend_inline: '(?=:\s*\S)'
  act_strict_tail: '(?=\s*?.*?\:\s*?(!.*?)?$)'
  if_strict_tail: '(?=\s*?.*?\:\s*?(!.*)?$)'
  else_caret_tail: '(?=\s*\:\s*?(!.*?)?$)'
  else_brace_tail: '(?=\s*?.*?\:\s*?(!.*?)?$)'
  elseif_strict_tail: '(?=\s+\S.*?\:\s*(!.*)?$)'
  elseif_permissive_tail: '(?=\s+\S.*?\:\s*([^!\s].*)?$)'
  # Шаг 3 рефакторинга (P1.6) — общие сегменты, ещё не вынесенные.
  # final_guard: один и тот же нулевой guard «строка началась с end/else/elseif/
  # if/-» (pop делает само правило) — было 5 побайтовых копий.
  final_guard: '(?=^\s*{{elseif_else_final}}([^\&\n\r]*))'
  # kw_calls: statement-список вызовов локаций (2 копии в location_call);
  # группа ЗАХВАТЫВАЮЩАЯ — номера capture в правилах не меняются.
  kw_calls: '(goto|gt|xgoto|xgt|gosub|gs)'
  # Левый контекст оператора: `\K`-версия (строки кода) и lookbehind-версия
  # (подвыражения `<< … >>` — там нет `^` строки). Захват сохранён.
  left_ctx_anchor: '(^\s*?|\&\s*?|\(\s*?|\{\s*?|\[\s*?)\K'
  left_ctx_lookbehind: '(?<=(<|\&|\(|\{|\[))'
  # P1.7 (HANDOFF §1r): `\s*?` → `\s*` нормализован ВЕЗДЕ, где за квантором стоит
  # ОБЯЗАТЕЛЬНЫЙ атом, не совпадающий с пробелом: позиция остановки единственна,
  # поэтому greedy и lazy дают один и тот же матч (доказано
  # `normalize_lazy_ws.py --against-head` на корпусе). ЛЕНИВЫЙ вариант оставлен
  # осознанно — «нормализовывать» его НЕЛЬЗЯ:
  #   * `arm_anchor` — квантор в КОНЦЕ матча: greedy съест отступ внутрь scope;
  #   * `left_ctx_anchor` — квантор перед `\K`: greedy сдвинет НАЧАЛО матча;
  #   * `pend_block_*`, `act_strict_tail`, `if_strict_tail`, `else_brace_tail`,
  #     `loop_strict_head` — квантор перед `.*`/`(!…)`/`$`: `\s` включает перевод
  #     строки, greedy дотянется до следующей строки и матч станет успешным там,
  #     где ленивый его не находил (класс бага `kw_elseif`, §1i).

contexts: # общие контексты подсветки кода локации
  # Тривиальный вход для самой базы (база hidden, реально используется
  # только через extends из форматов qsps/qsrc, у которых свой main).
  main:
    - include: location_body

  # Тело локации — два формата (plain вне {…} и braced внутри {…}).
  # После п.2.3 фаза-2 общие include-сегменты вынесены в body_common_*;
  # различаются форматы лишь 4 позициями (actions/conditions/loop и comments).
  # Вложенный `include` вставляет правила referenced-контекста на место —
  # порядок/приоритет matching сохранены 1:1 (фаза 1 поведение не меняла).
  body_common_head:
    - include: figure_brace
    - include: brackets_multiline
  body_common_mid:
    - include: kw_declarations
    - include: sugargosub
    - include: sugarfunc
    - include: wrong_end_else_elseif
    - include: preprocessor
  body_common_tail:
    - include: location_call
    - include: jump_to_label
    - include: labels
    - include: statements
    - include: operacion
    - include: system_variables
    - include: functions
    - include: numeric
    - include: strings
    - include: separator_continuation
    - include: users_variables
    # Фаза 10: пунктуация ОДНОстрочных ( ) [ ] — ПОСЛЕДНИМ include: anchor-правила
    # operacion, которые начинаются с '(' / '[' (напр. `(& x)`), должны выигрывать.
    - include: brackets_inline

  location_body: # @braced: auto
    # Порядок (Фаза 7): открыватели блоков act/if/loop ИДУТ ПЕРЕД body_common_head,
    # чтобы «bracket-arm» заголовка не проигрывал приоритет незакрытой «(» в
    # brackets_multiline. Для строк, не начинающихся с ключевого слова,
    # figure_brace/brackets_multiline отработают в своём include позже — 1:1.
    - include: multiline_actions
    - include: multiline_conditions
    - include: multiline_loop
    - include: body_common_head
    - include: body_common_mid
    - include: comments
    - include: body_common_tail

  # Тело в {…} — location_body_braced: СГЕНЕРИРОВАНО (@begin-generated ниже).

  # пользовательские переменные и специальные символы значений
  # `variable.other.qsp` — ЦВЕТОВОЙ scope (как `variable.language.qsp` у системных
  # и `support.function.qsp` у функций); `meta.user-variables.qsp` — внешний
  # маркер группы, чтобы тема/плагин могли красить переменные одним токеном.
  # У invalid-правила цветового scope нет намеренно: там работает invalid.
  users_variables:
    # ? — символ дефолтного значения (QSP 5.8+), подсвечивается как пользовательская переменная
    - match: '\?'
      scope: meta.user-variables.qsp variable.language.default.qsp
    - match: '{{users_variables}}(?=\s*\b(while|step|else|elseif|and|or|mod)\b)'
      scope: meta.user-variables.qsp variable.other.qsp
    - match: '{{users_variables}}(?=(\s+{{right_operand}}|\s*\({{right_operand}}))'
      scope: invalid.illegal.qsp meta.wrong_statement.qsp
    - match: '{{users_variables}}'
      scope: meta.user-variables.qsp variable.other.qsp

  # Прыжок на метку
  jump_to_label:
    - match: (jump)(?=\s*($|&))
      scope: invalid.illegal.qsp
    - match: (jump)\s*(('|").*?\3)
      captures:
        1: keyword.statement.qsp avs_statements
        2: string.quoted.double.qsp label_to_jump.qsp

  # вызовы локаций
  location_call:
    - match: '{{kw_calls}}(?=\s*($|&))'
      scope: invalid.illegal.qsp
    - match: '{{kw_calls}}\s*(({{ap}}|{{quote}}).*?\3)'
      captures:
        1: keyword.statement.qsp avs_statements
        2: string.quoted.double.qsp callable_locs.qsp
    - match: (func)(\()(('|").*?\4)
      captures:
        1: support.function.qsp
        3: string.quoted.double.qsp callable_locs.qsp

  # NB (fidelity к qsp_grammar.peg, п.6.3): имя пользователя — `{{sugar_name}}`
  # (любые Unicode-буквы, цифры, `_`, `.`, `#`), `$`/`%` в имя не входят.
  sugargosub:
    - match: (\@\@)({{sugar_name}})
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp

  # неявный вызов функций
  sugarfunc:
    - match: (\@)({{sugar_name}})(?=\s*\()
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp markup.italic.qsp
    - match: (\@)({{sugar_name}})(?=\s*\b(while|step|else|elseif|and|or|mod)\b)
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp markup.italic.qsp
    - match: (\@{{sugar_name}}\s+{{right_operand}})
      scope: invalid.illegal.qsp markup.italic.qsp
    - match: (\@)({{sugar_name}})
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp markup.italic.qsp

  # действия (Фаза 2, п.2.1: former arms `(?<=\{)act` + `^act` слиты через
  # НЕ-захватывающую alternation якорей `(?:^|(?<=\{))` (оба якоря нулевой
  # ширины) — единая группа `(\s*?)`=group1, ключ. слово=group2, номера capture
  # сохранены в обеих ветках). Branch-reset `(?|…)` НЕ используем — эта сборка
  # Onigmo его не поддерживает ("undefined group option").
  # Единый end-tail = comment_after_end_in_brace (brace-aware модель едина для
  # обоих якорей — см. REFACTOR_PLAN §3 Решение-1; на верхнем уровне
  # разница видна только для редкого `end текст }`).
  multiline_actions: # @braced: auto
    # strict-arm: ':' на строке act → сразу тело
    - match: '{{arm_anchor}}{{kw_act}}{{act_strict_tail}}'
      scope: meta.begin_action.qsp
      captures:
        2: keyword.control.action.begin.qsp markup.italic.qsp
      push: multiline_actions_body
    # bracket-arm (Фаза 7): многострочная ( или [ в заголовке act → pending-заголовок,
    # решающий форму на ':' (см. multiline_act_pending).
    - match: '{{arm_anchor}}{{kw_act}}{{unbalanced_bracket_head}}'
      scope: meta.begin_action.qsp
      captures:
        2: keyword.control.action.begin.qsp markup.italic.qsp
      push: multiline_act_pending

  # pending-заголовок act: состояние «до ':'» (механика — как multiline_if_pending).
  multiline_act_pending: # @braced: auto
    # Фаза 9: конец локации в незакрытом заголовке — ошибка + выход. Здесь
    # guard именно `--` (wrongclose_locend), а НЕ wrongclose с одинарным `-`:
    # в заголовке мы на уровне выражения, и перенос вида `step i +=` ⏎ `    -1:`
    # начинается с `-` легально (в телах блоков — нет, там wrongclose прав).
    - include: wrongclose_locend
    - match: '{{pend_block_soft}}'
      pop: true
      push: multiline_actions_body
    - include: pending_inline_pop
    - include: location_body

  multiline_actions_body: # @braced: auto
    - include: comment_after_colon
    - match: ^(\s*)(?i:(\bend\b))
      scope: meta.end_action.qsp
      captures:
        2: keyword.control.action.end.qsp markup.italic.qsp
      pop: true
      push: comment_after_end_in_brace
    - include: wrongclose
    - include: wrong_close_in_brace
    - include: location_body

  # циклы (п.2.1: former `(?<=\{)loop` + `^loop` слиты; пуш-тело было идентично)
  multiline_loop: # @braced: auto
    # strict-arm: ':' на строке loop → сразу тело
    - match: '{{arm_anchor}}{{kw_loop}}{{loop_strict_head}}'
      scope: meta.begin_cycle.qsp
      captures:
        2: keyword.control.cycle.begin.qsp markup.italic.qsp
      push: multiline_loop_body
    # bracket-arm (Фаза 7 + 8): многострочная ( или [ в заголовке loop →
    # pre-while pending. Guard «while на строке» (был в Фазе 7) СНЯТ: скобка может
    # стоять и ДО 'while' — в инициализирующей группе grammar
    # `loopMultiLine = loopMarker ws (singleLineGroup ws)? whileMarker …`, где
    # `[1,…]` — `nonEmptyTuple` с `mws`, переносы внутри легальны. Требование
    # 'while' теперь проверяет сам pending (multiline_loop_pending_prewhile), а не
    # arm: блок открывается ТОЛЬКО если 'while' наступил раньше ':'.
    - match: '{{arm_anchor}}{{kw_loop}}{{unbalanced_bracket_head}}'
      scope: meta.begin_cycle.qsp
      captures:
        2: keyword.control.cycle.begin.qsp markup.italic.qsp
      push: multiline_loop_pending_prewhile
    # invalid-arm: loop без 'while' на строке И без незакрытой скобки — живёт в
    # multiline_loop (после всех валидных arm'ов); в pending его быть не должно.
    - match: '{{kw_loop}}{{loop_no_while}}'
      scope: invalid.illegal.qsp

  # pending-заголовок loop, состояние «while ЕЩЁ НЕ найден» (Фаза 8): едет по
  # многострочной скобке через location_body и нулевой ширины переходит в
  # multiline_loop_pending на первом 'while' (сам 'while' не съедается — красится
  # штатными правилами, 1:1 с однострочным заголовком).
  # Если ':' наступил РАНЬШЕ 'while' — заголовок битый (grammar требует while):
  # блок НЕ открываем, а идущие следом end/else словит wrong_end_else_elseif.
  multiline_loop_pending_prewhile: # @braced: auto
    # Фаза 9: конец локации в незакрытом заголовке — ошибка + выход
    - include: wrongclose_locend
    - match: '(?=\b(?i:while)\b)'
      pop: true
      push: multiline_loop_pending
    - match: '{{pend_block_soft}}'
      pop: true
    - include: pending_inline_pop
    - include: location_body

  # pending-заголовок loop: состояние «до ':'» при уже найденном 'while'
  # (механика — как multiline_if_pending).
  multiline_loop_pending: # @braced: auto
    # Фаза 9: конец локации в незакрытом заголовке — ошибка + выход
    - include: wrongclose_locend
    - match: '{{pend_block_soft}}'
      pop: true
      push: multiline_loop_body
    - include: pending_inline_pop
    - include: location_body

  multiline_loop_body: # @braced: auto
    - include: comment_after_colon
    - match: ^(\s*)(?i:(\bend\b))
      captures:
        2: keyword.control.cycle.end.qsp markup.italic.qsp
      pop: true
      push: comment_after_end_in_brace
    - include: wrongclose
    - include: wrong_close_in_brace
    - include: location_body

  # конструкции условий (п.2.1: former `(?<=\{)if` + `^if` слиты)
  multiline_conditions: # @braced: auto
    # strict-arm: ':' на строке if → сразу тело
    - match: '{{arm_anchor}}{{kw_if}}{{if_strict_tail}}'
      scope: meta.begin_condition.qsp
      captures:
        2: keyword.control.conditional.begin.qsp markup.italic.qsp
      push: multiline_conditions_body
    # bracket-arm (Фаза 7): многострочная ( или [ в заголовке if — ':' уехал за
    # пределы строки ключевого слова, strict-arm не срабатывает. Пушим pending-заголовок:
    # он едет по многострочной скобке (location_body → multiline_round) и решает форму
    # ТОЛЬКО на видимом ':' (см. multiline_if_pending). Иначе однострочная форма с
    # многострочной скобкой (`…] = $arr: *pl …`) ложно открывала бы блок и else/end
    # не ловились бы как excess.
    - match: '{{arm_anchor}}{{kw_if}}{{unbalanced_bracket_head}}'
      scope: meta.begin_condition.qsp
      captures:
        2: keyword.control.conditional.begin.qsp markup.italic.qsp
      push: multiline_if_pending

  # pending-заголовок if: состояние «до ':'». Zero-width решения не съедают ':' —
  # его доедает либо тело (block), либо location_body (single-line), как в strict-arm.
  multiline_if_pending: # @braced: auto
    # Фаза 9: конец локации в незакрытом заголовке — ошибка + выход
    - include: wrongclose_locend
    # ':' и до конца строки только пробел/комментарий → блочная форма → то же тело,
    # что у strict-arm.
    - match: '{{pend_block_strict}}'
      pop: true
      push: multiline_conditions_body
    # ':' и на этой же строке утверждение → однострочная форма → блок НЕ открываем;
    # возвращаемся в location_body, а идущие следом else/end словит wrong_end_else_elseif.
    - include: pending_inline_pop
    - include: location_body

  # тело if-конструкции (Фаза 7: вынесено из inline-push strict-arm, поведение 1:1;
  # используют оба arm'а).
  multiline_conditions_body: # @braced: auto
    - include: comment_after_colon
    - match: ^(\s*)(?i:(\bend\b))
      captures:
        2: keyword.control.conditional.end.qsp markup.italic.qsp
      pop: true
      push: comment_after_end_in_brace
    - include: multiline_actions_elseif
    - include: multiline_actions_else
    - include: wrongclose
    - include: wrong_close_in_brace
    - include: location_body

  wrong_end_else_elseif:
    - match: (?i:(\bend\b)) # подсветка лишнего end'а
      scope: invalid.illegal.qsp meta.excess_end.qsp
    - match: ^(?:\s*)(?i:(\belse\b)) # лишний else
      scope: invalid.illegal.qsp meta.excess_else.qsp
    - match: ^(?:\s*)(?i:(\belseif\b)) # elseif работает только в многострочной форме (исправить, если изменится в 5.8.0)
      scope: invalid.illegal.qsp meta.excess_elseif.qsp

  # Ошибочные закрытия контейнеров (п.3.3): порядок include'ов зафиксирован —
  # «сначала ошибки, потом тело» (wrongclose → wrong_close_in_brace →
  # location_body[_braced]). Правила ловят РАЗНЫЕ символы в непересекающихся
  # позициях (`-` в начале строки против `}` где угодно), поэтому взаимный
  # порядок wrongclose/wrong_close_in_brace на matching не влияет — но он
  # ЕДИНОЙ душой везде и менять его по отдельности нельзя.
  # wrongclose: «-» в начале строки внутри незакрытого act/loop/if —
  # ложный признак конца локации.
  wrongclose:
    - match: ^\s*(-)(.*)({{nr}}$|$)
      scope: invalid.illegal.qsp
      pop: true

  # Фаза 9: «конец локации» (`--`), попадающий в НЕзакрытую многострочную
  # скобку `( …` / `[ …` / `{ …` — тоже ошибка, как и `wrongclose` для незакрытого
  # act/if/loop (не поставлен `end`): строка `--` красится invalid и закрывает
  # ровно один уровень. Здесь требуются ИМЕННО две дефисы (qsp_grammar.peg
  # `endLocMarker`, п.6.6), потому что перенос выражения с унарным минусом
  # (`(1 +` ⏎ `    -2)`) внутри скобок ЛЕГАЛЕН и его ловит правило-продолжение
  # `^\s+(?=[+\-*\/<>=,&])` — guard поэтому стоит СТРОГО РАНЬШЕ него.
  wrongclose_locend:
    - match: ^\s*(--)(.*?)({{nr}}$|$)
      scope: invalid.illegal.qsp
      pop: true

  # wrong_close_in_brace: «}» внутри незакрытой конструкции (контейнер ещё
  # не дописан) — ошибка и выход из контейнера. НАМЕРЕНИЕ (REFACTOR_PLAN §1C.3):
  # согласовано с семантикой «незакрытая конструкция = ошибка».
  wrong_close_in_brace:
    - match: \}(.*)({{nr}}$|$)
      scope: invalid.illegal.qsp avs_error avs_wrongelse1
      pop: true

  # --- Общие include-сегменты тел else/elseif/pending (Шаг 2: P1.2 + P1.4) --
  # Вынесены ПОСТРОЧНО идентичные inline-тела push-стеков (поведение 1:1:
  # include внутри push-списка разворачивает правила ровно на своём месте).
  # Различие plain↔braced остаётся ТОЛЬКО в финальном include location_body /
  # location_body_braced, поэтому сами сегменты не содержат суффикса _braced и
  # инклюдятся обоими зеркалами одинаково. САМИ braced-зеркала с шага 4 не
  # пишутся руками: их генерирует gen_braced.py в @begin-generated (§ниже).
  #
  # else/elseif: возврат из незакрытого pending-заголовка на inline-':' (P1.4);
  # один и тот же во всех пяти plain и пяти braced pending-контекстах:
  pending_inline_pop:
    - match: '{{pend_inline}}'
      pop: true
  # else: illegal_multiline_else + final-guard (без comment_after_colon) —
  # голова «голого» else (arm5) и else-с-условием (arm4):
  else_body_head_bare:
    - include: illegal_multiline_else
    - match: '{{final_guard}}'
      pop: true
  # else: comment_after_colon + голова — caret/brace arm'ы (arm2/arm3):
  else_body_common_head:
    - include: comment_after_colon
    - include: else_body_head_bare
  # else: ошибочные закрытия перед телом (location_body подключается в arm'е):
  else_body_guarded_tail:
    - include: wrongclose
    - include: wrong_close_in_brace
  # Тело многострочного else (`else !коммент` / голый `else`) одним ИМЕНОВАННЫМ
  # контекстом: arm `else !коммент` пушит СРАЗУ ДВА контекста (тело + хвост-
  # комментарий), и после pop'а комментария по newline верхним должно оказаться
  # ровно это тело; тот же контекст пушит и bare-arm. Зеркало для {…}
  # (else_body_block_braced) — в @begin-generated.
  else_body_block: # @braced: auto
    - include: else_body_head_bare
    - include: else_body_guarded_tail
    - include: location_body

  # МЁРТВЫЙ РЕГИОН однострочных else/elseif.
  # По грамматике хвост `else: <stmt>` / `else <stmt>` / `elseif <cond>: <stmt>`
  # делает конструкцию ОДНОСТРОЧНОЙ: строки ниже не исполняются, но ПЛЕЕР их всё
  # равно СКАНИРУЕТ с учётом кавычек/апострофов/скобок. Поэтому регион красим
  # настоящим многострочным комментарием с ТОЙ ЖЕ структурой, что и обычные
  # комментарии (общие quote_apostroph_comments / brace_comments /
  # special_comments_line), а НЕ построчным `^.*` (он забирает строку с позиции 0
  # и не даёт сработать кавычкам/скобкам).
  #
  # Входные кадры (plain + braced-зеркало): хвост САМОЙ строки else/elseif —
  # обычное тело (location_body), а на НАЧАЛЕ следующей строки кадр заменяет
  # себя на регион (pop + push = set; для push совместимо со ST3). Якорь ИМЕННО
  # `^`: `$`/newline не годится — хвост-комментарий (`else: & !…`) съедает
  # перевод строки своим pop'ом, и `$`-правило уже не сработало бы.
  #
  # Сам регион braced-зеркала НЕ имеет: внутри мёртвого кода {…} — это
  # структура КОММЕНТАРИЯ, а не блок кода, т.е. тело от окружения не зависит.
  # braced-зеркала нужны только входным кадрам —
  # else_dead_line_braced / elseif_dead_line_braced — и живут в @begin-generated.
  dead_code_comment:
    - meta_scope: comment.qsp
    # выход из региона: строка началась с end/else/elseif/if/`-`
    - match: '{{final_guard}}'
      pop: true
    # структура — ТА ЖЕ, что у обычного комментария (comment_tail_common):
    # состояния "…"/'…'/{…} живут через переносы строк, поэтому `end` внутри
    # литерала или вложенных {…} регион НЕ закрывает (как в плеере)
    - include: quote_apostroph_comments
    - include: brace_comments
    # спец-комментарий `!@`: вариант line — регион продолжается со следующей
    # строки, т.е. тело завершается там же, где обычный комментарий
    - include: special_comments_line

  else_dead_line: # @braced: auto
    - match: '^'
      pop: true
      push: dead_code_comment
    - include: else_body_guarded_tail
    - include: location_body

  elseif_dead_line: # @braced: auto
    - match: '^'
      pop: true
      push: dead_code_comment
    - include: location_body

  # elseif strict-arm: comment_after_colon + final-guard:
  elseif_body_head_strict:
    - include: comment_after_colon
    - match: '{{final_guard}}'
      pop: true
  # elseif permissive-arm (ОДНОСТРОЧНЫЙ `elseif …: <stmt>`): тело-комментарий
  # УДАЛЕНО вместе с построчным `^.*` (2026-10-28): строки ниже до
  # else/elseif/end красит общий многострочный регион dead_code_comment,
  # входной кадр — elseif_dead_line[_braced].

  # else (грамматика: elseClause = elseMultiLine | elseSingleLine, двоеточие
  # представляет `(":" ws)?`). Arms идут от специфичных к общим, ПОРЯДОК ЗНАЧИМ:
  #   1) invalid: `else <условие>:` — else условия не допускает (вся строка);
  #   2) colon/caret `^else …:`   3) colon/brace `{else …:` — блок, хвост после ':' = коммент;
  #   4) colon-single `else: <stmt>` — однострочный: строки ниже до end = мёртвый
  #      код → МНОГОСТРОЧНЫЙ комментарий (else_dead_line → dead_code_comment);
  #      `else:` и `else: !коммент` забирает (2);
  #   5) stmt-single `else <stmt>` без ':' — тот же приём, что (4);
  #   6) `else !коммент` без ':' — ХВОСТ = КОНТЕКСТ комментария (comment_after_else),
  #      под ним — ТЕЛО else (else_body_block), т.е. строки ниже = КОД;
  #   7) bare `else` без хвоста — тело со следующих строк = КОД.
  # Водораздел «код-тело (6/7) vs мёртвый код (4/5)» = наличие однострочного хвоста.
  # braced-зеркало — multiline_actions_else_braced (в @begin-generated).
  multiline_actions_else: # @braced: auto
    # Строго В ПРЕДЕЛАХ СТРОКИ (`[ \t]`/`[^:\n\r]`): с прежними `\s*?` + `[^:]+`
    # правило матчило «else ⏎ if …:» (вложенный if в теле else) как условие→invalid.
    - match: ^[ \t]*?(?i:(\belse\b))([ \t]*?)([^:\n\r]+)(\:).*$
      scope: invalid.illegal.qsp meta.wrong_else_conditional.qsp
    - match: '^(\s*)(?i:(\belse\b)){{else_caret_tail}}'
      scope: meta.begin_else.qsp
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: else_body_common_head
        - include: else_body_guarded_tail
        - include: location_body
    - match: '(?<=\{)(\s*)(?i:(\belse\b)){{else_brace_tail}}'
      scope: meta.begin_else.qsp
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: else_body_common_head
        - include: else_body_guarded_tail
        - include: location_body
    # «else <текст>:» (однострочная форма с условием/хвостом). Двоеточие ЗДЕСЬ
    # ОБЯЗАТЕЛЬНО (изменена `(:?)`→`(:)`, 2026-10-28): опциональное `:` позволяло
    # этому arm'у схватить «голый» else и закрасить КОММЕНТАРИЕМ все строки тела до end — хотя
    # многострочный else без ':' легален (тело начинается со следующей строки).
    # Голый else доходит до bare-arm ниже, `else !коммент` — до своего arm'а.
    - match: '(?:^|(?<=\{))(\s*)(?i:(\belse\b))\s*(:)(?=\s*([^!\s].*)?$)'
      scope: meta.begin_else.qsp
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
        3: punctuation.definition.keyword.qsp
      push: else_dead_line
    # Однострочный `else <statements>` БЕЗ двоеточия (elseSingleLine, двоеточие
    # факультативно `(":" ws)?`). Зеркало arm4 (колонной однострочной формы): хвост
    # строки красится штатно (location_body), а ВСЕ последующие строки до `end` —
    # мёртвый код → многострочный комментарий (else_dead_line → dead_code_comment).
    # Условие входа: после else горизонтальный `[ \t]+` и следующий символ НЕ `!`
    # и не пробел (иначе это комментарий-строка → многострочный else, см. нижний
    # bare-arm). `end`/`else`/`elseif` на последующих строках словит final_guard
    # региона.
    - match: '(?:^|(?<=\{))(\s*)(?i:(\belse\b))[ \t]+(?=[^!\s])'
      scope: meta.begin_else.qsp
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push: else_dead_line
    # `else !коммент` БЕЗ ':' — многострочный else с хвостом-комментарием
    # (elseMultiLine: `(":" ws)? commentStatement?`). В match берём ТОЛЬКО
    # открывающий `!` (capture → punct): тело комментария уходит в контекст
    # comment_after_else (pop по newline), поэтому внутри работают "…"/'…'/{…}
    # и '@'-спецы — как после ':'. Якорь `^` + `[ \t]+` строго фиксирует позицию
    # «сразу после else», поэтому NOT в теле (`x = !y`) не затрагивается.
    # Список push: правый контекст — верхний, т.е. комментарий лежит НАД телом
    # else; после его pop'а по newline верхним становится тело.
    # `comment.qsp` есть и в capture: тело контекста использует meta_content_scope
    # (чтобы не накрыть `else`), поэтому сам `!` получает comment-scope только
    # через capture — ровно как у comment_after_colon.
    - match: '^(\s*)(?i:(\belse\b))[ \t]+(!)'
      scope: meta.begin_else.qsp
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
        3: comment.qsp punctuation.definition.comment.begin.qsp main_comment_start.qsp
      push:
        - else_body_block
        - comment_after_else
    # Многострочный `else` БЕЗ хвоста-утверждения: голый `else` (+ хвостовые
    # пробелы). elseMultiLine — двоеточие факультативно; хвост-комментарий ловит
    # arm выше. Тело — СЛЕДУЮЩИЕ строки → КОД (фикс 1b: здесь НЕТ catch-all
    # `^.*`→comment). Выход по final-guard на `end`/`else`/`elseif`. Однострочные
    # формы (`else <stmt>` без ':') и колонные (`else:` / `else: <текст>` /
    # `else <конд>:`) — выше.
    - match: '^(\s*)(?i:(\belse\b))(?=[ \t]*$)'
      scope: meta.begin_else.qsp
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push: else_body_block

  illegal_multiline_else:
    - match: (?:^\s*)(?i:\belse\b)
      scope: invalid.illegal.qsp meta.excess_multiline_else.qsp

  # elseif (п.2.1): пары `^`/{`-arms слиты через branch-reset; тела были
  # идентичны с точностью до порядка comment_after_colon/final-guard —
  # приведены к порядку comment-первым (guard — нулевой ширины, на
  # середине строки не срабатывает, так что порядок comment_after_colon
  # внутри одного пуша не менял matching для обеих веток).
  multiline_actions_elseif: # @braced: auto
    # `else if` (grammar `elseIfSpaceMarker = "else" ws "if"`) трактуется как ЕДИНЫЙ
    # elseif-оператор: `\b(?:else[ \t]+if|elseif)\b` внутри прежней capture-группы
    # (нумерация групп сохранена — внутренняя alternation не захватывающая).
    # `[ \t]+`, а НЕ `\s+`: внутристрочно — как в грамматике (`ws` без переноса).
    - match: '{{arm_anchor}}{{kw_elseif}}{{elseif_strict_tail}}'
      scope: meta.begin_condition.qsp
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: elseif_body_head_strict
        - include: location_body
    # permissive-arm = ОДНОСТРОЧНЫЙ elseif (`elseif <cond>: <stmt>`): строки ниже
    # до else/elseif/end — мёртвый код → тот же многострочный комментарий, что
    # и у однострочного else (dead_code_comment), см. elseif_dead_line.
    - match: '{{arm_anchor}}{{kw_elseif}}{{elseif_permissive_tail}}'
      scope: meta.begin_condition.qsp
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
        3: punctuation.definition.keyword.qsp
      push: elseif_dead_line
    # bracket-arm (Фаза 7): многострочная ( или [ в elseif-условии → pending-
    # заголовок, решающий форму на ':' (см. multiline_elseif_pending). Ветка
    # снимается по sibling-guard (elseif_else_final) при следующем else/elseif/end —
    # как и ordinary elseif.
    - match: '{{arm_anchor}}{{kw_elseif}}{{unbalanced_bracket_head}}'
      scope: meta.begin_condition.qsp
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push: multiline_elseif_pending

  # pending-заголовок elseif: состояние «до ':'» (механика — как multiline_if_pending).
  multiline_elseif_pending: # @braced: auto
    # Фаза 9: конец локации в незакрытом заголовке — ошибка + выход
    - include: wrongclose_locend
    - match: '{{pend_block_soft}}'
      pop: true
      push: multiline_elseif_body
    - include: pending_inline_pop
    - include: location_body

  multiline_elseif_body: # @braced: auto
    - include: comment_after_colon
    - match: '{{final_guard}}'
      pop: true
    - include: location_body

  # @begin-generated
  # # # --- braced-двойники (тело внутри {…}): СГЕНЕРИРОВАНО --- # # #
  # Источник правды — plain-контексты с маркером `# @braced: auto`.
  # Правь plain → `python _disdocs/syntax_highlighting/gen_braced.py
  # --write` → коммить. РУЧНАЯ правка региона запрещена: дрейф валит
  # check_syntax_phase1.py (и побайтную сверку региона, и парность 5.1).
  # Нужны потому, что Sublime не умеет «заглянуть в стек»: признак
  # «открыт ли {…}» кодируется выбором location_body / location_body_braced.

  location_body_braced:
    # ← сгенерировано из location_body
    - include: multiline_actions_braced
    - include: multiline_conditions_braced
    - include: multiline_loop_braced
    - include: body_common_head
    - include: body_common_mid
    - include: comments_in_brace
    - include: body_common_tail

  multiline_actions_braced:
    # ← сгенерировано из multiline_actions
    - match: '{{arm_anchor}}{{kw_act}}{{act_strict_tail}}'
      scope: meta.begin_action.qsp
      captures:
        2: keyword.control.action.begin.qsp markup.italic.qsp
      push: multiline_actions_body_braced
    - match: '{{arm_anchor}}{{kw_act}}{{unbalanced_bracket_head}}'
      scope: meta.begin_action.qsp
      captures:
        2: keyword.control.action.begin.qsp markup.italic.qsp
      push: multiline_act_pending_braced

  multiline_act_pending_braced:
    # ← сгенерировано из multiline_act_pending
    - include: wrongclose_locend
