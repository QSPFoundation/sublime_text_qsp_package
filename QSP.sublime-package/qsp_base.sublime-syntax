      scope: keyword.operator.two-signs.qsp

  operacion_ampersand_common:
    # Амперсанды: `\K`-вариант «без левого операнда» работает только в строках кода,
    # а в pushed-контексте `<< … >>` — нет, поэтому operacion_subex не включает этот
    # контекст (у неё локальный lookbehind-двойник).
    - match: (^\s*?|\(\s*?|\{\s*?|\[\s*?)\K(\&)(?=\s*?{{right_operand}}*)
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_left
    - match: \&
      scope: keyword.operator.ampersand.qsp

  # Запятая: «без правого операнда» и разделитель построчно идентичны в operacion и
  # operacion_subex, а with_out_left разный — поэтому вынесены два независимых сегмента
  # (порядок значим: with_out_right → with_out_left → разделитель).
  operacion_comma_with_out_right:
    - match: (?<={{left_operand}})\s*(,)(?!\s*{{right_operand}})
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_right
  operacion_comma_sign:
    - match: (,)
      scope: punctuation.separator.comma.qsp

  # `no`: пары правил в operacion и operacion_subex отличались только регистром
  # (в subex — регистрозависимый \bno\b). Ключевые слова QSP регистронезависимы →
  # пара слита с (?i:); `NO`/`No` в `<< … >>` теперь keyword/invalid, а не переменная.
  operacion_no_common:
    - match: (?i:\bno\b)(?!\s*{{right_operand}})
      scope: invalid.illegal.qsp avs_wrong_no_with_out_right
    - match: (?i:\bno\b)
      scope: keyword.operator.word.qsp

  operacion:
    - include: operacion_word_two_signs_common
    # подсветка для однознаковых операторов
    - match: '\-(?=\s*{{right_operand}})'
      scope: keyword.operator.one-sign.qsp
    - match: (?<={{left_operand}})\s*{{operacion_one_sign}}(?!\s*{{right_operand}})
      scope: invalid.illegal.qsp avs_wrong_one_sign_with_out_right
    - match: '{{left_ctx_anchor}}{{operacion_one_sign}}(?=\s*?{{right_operand}}*)'
      scope: invalid.illegal.qsp avs_wrong_one_sign_with_out_left
    - match: '{{operacion_one_sign}}'
      scope: keyword.operator.one-sign.qsp
    # Правила для запятых
    - include: operacion_comma_with_out_right
    - match: '{{left_ctx_anchor}}(,)(?=\s*?{{right_operand}}*)'
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_left
    - include: operacion_comma_sign
    - include: operacion_ampersand_common
    - include: operacion_no_common

  numeric:
    # Неправильные «переменные», начинающиеся с цифр: класс букв — `\p{L}` (как в
    # users_variables), покрывает `ё`/греческий/диакритику. NB: `\d` в класс НЕ добавлять —
    # на чистом `100` backtracking ложно покрасит всё число invalid'ом.
    - match: \b\d+([\p{L}\$\%\._]+\d*)+\b # неправильные переменные, начинающиеся с цифр
      scope: invalid.illegal.qsp avs_wrong_numeric
    - match: \b[0-9]+\b
      scope: constant.numeric.qsp avs_numeric

  statements:
    # подсветка statement'ов
    - match: \b({{kw_statements}}|{{kw_text_statements}})\b(?!\()
      scope: keyword.statement.qsp avs_statements
    - match: \b({{kw_statements}})\b(?=\()
      scope: support.function.other.qsp avs_statements
    - match: (\*)(\b({{kw_text_statements}})\b)(?=\()
      captures:
        1: support.function.star.qsp punctuation.definition.function.qsp
        2: support.function.other.qsp avs_statements
    - match: (\*)(?={{kw_text_statements}}\b)
      scope: keyword.statement.star.qsp punctuation.definition.keyword.qsp avs_star
    - match: \b{{kw_controls}}\b
      scope: keyword.control.qsp markup.italic.qsp
    - match: (\*)(?={{kw_statements}}\b)
      scope: invalid.illegal.qsp avs_wrong_star_statements
    - match: (\*)(?={{kw_controls}}\b)
      scope: invalid.illegal.qsp avs_wrong_star_controls

  system_variables:
    - match: (%)(\b{{system_vars_string}}\b)
      scope: invalid.illegal.qsp avs_illegal_textvariables
    # # — числовой префикс перед строковой системной переменной → ошибка
    - match: (\#)(\b{{system_vars_string}}\b)
      scope: invalid.illegal.qsp avs_illegal_textvariables

    - match: |-
        (?x:
          ({{system_vars}}|{{system_vars_string}})
          (?=(\s+{{right_operand}}|\s*\({{right_operand}}))
        )
      scope: invalid.illegal.qsp

    - match: |-
        (?x:
          ({{system_vars}}|{{system_vars_string}})
          (?=\$({{system_vars}}|{{system_vars_string}}))
        )
      scope: invalid.illegal.qsp avs_illegal_textvariables

    - match: (?<=[\w\.\$]\$)({{system_vars}}|{{system_vars_string}})
      scope: invalid.illegal.qsp avs_illegal_textvariables

    # 4 правила «префикс перед системной переменной» одного scope слиты в один `(?x)`-сегмент.
    # Каждая ветка матчит СВОЙ символ префикса → на позицию попадает ≤1 ветка, альтернация
    # не расширяет набор позиций. Два `#`-правила объединены в одну ветку (цели дизъюнктны).
    - match: |-
        (?x:
          (\$)(?=\b({{system_vars_string}}|{{system_vars}})\b)
          |(\%)(?=\b({{system_vars}})\b)
          |(\#)(?=\b({{system_vars_num}}|{{system_vars}})\b)
        )
      scope: variable.language.qsp punctuation.definition.variable.qsp avs_sysvar

    - match: \b({{system_vars_num}}|{{system_vars_string}}|{{system_vars}})\b
      scope: variable.language.qsp avs_sysvar

      # подсвечивает символ доллара перед названием числовых переменных
    - match: (\$|%)(?={{system_vars_num}}\b)
      scope: invalid.illegal.qsp avs_illegal_$

  # намеренная реализация: `loc`/`obj` в grammar входят в `unaryKeywordOperator`, но
  # здесь красятся ТОЛЬКО как функции (`support.function.qsp`). В реальном коде они
  # прежде всего функции; разведение «оператор vs функция» требует анализа операндов
  # и даёт малую пользу при риске ложных срабатываний.
  functions:
      # `#` перед НЕчисловой функцией (string/tuple) → ошибка типа (2 правила слиты в одну ветку)
    - match: (\#)(?=\b({{functions_string}}|{{functions_tuple}})\b)
      scope: invalid.illegal.qsp avs_wrong_type_prefix
      # Корректный префикс типа (`$`→string/alltypes, `%`→tuple/alltypes, `#`→num/alltypes):
      # 3 правила одного scope слиты в `(?x)`-сегмент (каждая ветка — свой символ префикса).
    - match: |-
        (?x:
          (\$)(?=({{functions_string}}\b|{{functions_alltypes}}\b))
          |(\%)(?=({{functions_tuple}}\b|{{functions_alltypes}}\b))
          |(\#)(?=({{functions_num}}\b|{{functions_alltypes}}\b))
        )
      scope: support.function.qsp punctuation.definition.function.qsp avs_function
      # подсветка непосредственно названий функций
    - match: |-
        (?x:
          \b(
          {{functions_num}}|
          {{functions_string}}|
          {{functions_tuple}}|
          {{functions_alltypes}}
          )\b
        )
      scope: support.function.qsp avs_function
      # НЕверный префикс типа (`$`/`%` перед num, `%` перед string, `$` перед tuple):
      # 3 правила одного scope слиты в `(?x)`-сегмент, номера capture не меняются.
    - match: |-
        (?x:
          (\$|\%)(?=\b{{functions_num}}\b)
          |(\%)(?=\b{{functions_string}}\b)
          |(\$)(?=\b{{functions_tuple}}\b)
        )
      scope: invalid.illegal.qsp avs_wrong_type_prefix

  # Метка (`:name`). Якорь `^` ОБЯЗАТЕЛЕН: плеер находит метки только в начале строки,
  # `:` в середине выражения — не метка.
  # намеренная реализация:
  #   * скобки внутри метки ДОПУСКАЮТСЯ (шире grammar `noteChar`) — метки однострочны,
  #     многострочные скобки внутри не нужны, это не ошибка;
  #   * метка после `&` и кавычки в метке НЕ поддержаны: плеер распознаёт метку только
  #     в начале строки и ломается на кавычках → класс `[^&'"\n]+` (строка с ними не метка).
  labels:
    - match: ^(\s*):([^&'"\n]+)
      captures:
        2: entity.name.qlabel.qsp avs_jumps_labels

  # # # ------------------- строки ------------------------ # # #
  # Общий body (preprocessor+subexpression+htmlsupport) вынесен в string_common;
  # различие двух arms — только символ кавычки и правило удвоения (`""`/`''`).
  # meta_scope каждого arm'а — по СВОЕЙ кавычке (`double`/`single`).
  # намеренная реализация: `jump_to_label`/`location_call` красят ОБЕ кавычки `double` —
  # там строка-аргумент ловится ОДНОЙ группой (`({{ap}}|{{quote}}).*?\3`), разделить нечем.
  strings:
    - match: '"'
      push:
        - meta_scope: string.quoted.double.qsp
        - match: '""'
          scope: constant.character.escape.qsp
        - match: '"'
          pop: true
        - include: string_common
    - match: "'"
      push:
        - meta_scope: string.quoted.single.qsp
        - match: "''"
          scope: constant.character.escape.qsp
        - match: "'"
          pop: true
        - include: string_common

  string_common:
    - include: preprocessor
    - include: subexpression
    - include: htmlsupport

  subexpression:
    - match: '<<'
      scope: punctuation.section.interpolation.begin.qsp avs_begin_subexpression
      push:
        - clear_scopes: true
        - meta_scope: meta.interpolation.qsp
        - meta_content_scope: source.qsp.embedded
        - match: '>>'
          scope: punctuation.section.interpolation.end.qsp avs_end_subexpression
          pop: true
        - include: subex

  subex:
    - include: figure_brace
    - include: sugarfunc
    # Многострочность подвыражения `<< … >>` (grammar `stringSubexpression`, `mws`
    # допускает перенос) разрешена только внутри скобок и вложенных строк: переносы
    # в `(`/`[` поглощает multiline_round/square, `{…}` — figure_brace, строки — strings.
    # Правило ниже ловит ГОЛЫЙ перенос (вне скобок/строк) — он остаётся ошибкой.
    - include: brackets_multiline
    - match: (\n\r|\r|\r\n|\n)
      scope: invalid.illegal.qsp avs_wrongenter
    - include: operacion_subex
    - include: system_variables
    - include: functions
    - include: numeric
    - include: strings
    - include: users_variables
    # Пунктуация однострочных ( ) [ ]: включена ПОСЛЕДНЕЙ — anchor-правила, начинающие
    # матч с `(`/`[`, должны пробоваться раньше (порядок как в body_common_tail).
    # `&` без левого операнда в subex — локальное lookbehind-правило (operacion_ampersand_common
    # с `\K` здесь не инклюдится).
    - include: brackets_inline

  operacion_subex:
    # Операции внутри подвыражения `<< … >>` (embedded source). Общие с `operacion`
    # сегменты вынесены в *_common; локально оставлены только реально отличающиеся
    # группы: one_sign (нет unary `-`; with_out_right несёт доп. exclusion `(>…)`;
    # with_out_left — lookbehind вместо `\K`, т.к. здесь нет `^` строки кода), comma
    # with_out_left (тот же lookbehind) и ampersand (`\K`-версия в pushed-контексте не работает).
    - include: operacion_word_two_signs_common
    # подсветка однознаковых операторов
    - match: (?<={{left_operand}})\s*{{operacion_one_sign}}(?!(>|\s*{{right_operand}}))
      scope: invalid.illegal.qsp avs_wrong_one_sign_with_out_right
    - match: '{{left_ctx_lookbehind}}\s*{{operacion_one_sign}}(?=\s*?{{right_operand}}*)'
      scope: invalid.illegal.qsp avs_wrong_one_sign_with_out_left
    - match: '{{operacion_one_sign}}'
      scope: keyword.operator.one-sign.qsp
    # Правила для запятых
    - include: operacion_comma_with_out_right
    - match: '{{left_ctx_lookbehind}}\s*(,)(?=\s*?{{right_operand}}*)'
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_left
    - include: operacion_comma_sign
    # Амперсанды: локальный lookbehind-двойник вместо operacion_ampersand_common — его
    # `\K`-правило в pushed-контексте не срабатывает. Семантика зеркальная: `&` сразу
    # после <|&|(|{|[) без левого операнда — ошибка.
    - match: '{{left_ctx_lookbehind}}\s*(\&)(?=\s*?{{right_operand}}*)'
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_left
    - match: \&
      scope: keyword.operator.ampersand.qsp
    - include: operacion_no_common

  # --- Подсветка комментариев ---
  # Общий хвост комментария: тело от «!» до конца строки. Используют comments и
  # comments_in_brace (их arms различаются только якорем и «?\}»-попом). ПОРЯДОК
  # правил внутри push-тел значим — менять только вместе с анализом коллизий.
  comment_tail_common:
    - match: (\n\r|\r|\r\n|\n|$)
      scope: comment.qsp
      pop: true
    - include: quote_apostroph_comments
    - include: brace_comments
    # Спец-комментарий `!@` подключается САЙТОМ, а не здесь: его завершители
    # обязаны совпадать с завершителями тела-хозяина, а они у plain- и
    # braced-версий разные (см. блок special_comments_*).

  # Комментарий «!» — однострочный или многострочный (через &-продолжения).
  # Arms НЕ слиты в один regex: «^\s*» матчит только в начале строки, а «\&» — в
  # любой позиции; общая альтернация ложно расширяла бы набор позиций. Тело — comment_tail_common.
  comments:
    - match: (?<=\{)((\s*)|(\&)\s*)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - include: comment_tail_common
        - include: special_comments_line
    - match: ((^\s*)|(\&)\s*)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - include: comment_tail_common
        - include: special_comments_line

  # Комментарии внутри открытого {…} блока.
  # Отличие от comments: комментарий схлопывается НУЛЕВЫМ lookahead «(?=\})»,
  # не поглощая «}»: если на строке-комментарии стоит «}» нулевого уровня
  # вложенности (нет незакрытой вложенной «{» из brace_comments), то это
  # закрывающая скобка самого блока — её ловит правило закрытия figure_brace.
  # Внутри строковых литералов (quote_apostroph_comments) и вложенных {…}
  # (brace_comments) «}» остаётся защищённой и блок не закрывает.
  comments_in_brace:
    - match: (?<=\{)((\s*)|(\&)\s*)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - match: (?=\})
          pop: true
        - include: comment_tail_common
        - include: special_comments_braced
    - match: ((^\s*)|(\&)\s*)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - match: (?=\})
          pop: true
        - include: comment_tail_common
        - include: special_comments_braced

  comment_after_colon: # комментарии после двоеточия
    - match: (?<=:)((\s*)|(\&)\s*)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.begin.qsp main_comment_start.qsp
      push:
        - meta_scope: comment.qsp
        - match: (\n\r|\r|\r\n|\n|$)
          scope: punctuation.definition.comment.end.qsp main_comment_end.qsp
          pop: true
        - include: quote_apostroph_comments
        - include: brace_comments
        - include: special_comments_line

  # Хвост-комментарий в заголовке многострочного else (`else !коммент`): ':' по
  # grammar факультативен, поэтому comment_after_colon (lookbehind `(?<=:)`) этот
  # случай не ловит, а `comments` видит `!` только в начале строки или после `&`.
  # Здесь живёт ТОЛЬКО тело (до newline, с "…"/'…'/{…} и '@'-спецами). meta_content_scope
  # (НЕ meta_scope): scope комментария не должен накрывать сам `else`.
  comment_after_else:
    - meta_content_scope: comment.qsp
    - match: '({{nr}}|$)'
      scope: punctuation.definition.comment.end.qsp main_comment_end.qsp
      pop: true
    - include: quote_apostroph_comments
    - include: brace_comments
    - include: special_comments_line

  # Комментарий после 'end': весь текст до '&' или конца строки; внутри {…}
  # закрывающая '}' завершает и комментарий, и внешний блок (ловит figure_brace).
  # Все правила 'end' ведут только этот brace-aware контекст. Не переносить порядок
  # правил в comment_tail_common: здесь «&»-pop стоит ПОСЛЕ include'ов и это значимо.
  comment_after_end_in_brace:
    - meta_content_scope: comment.line.qsp markup.italic.qsp
    - include: quote_apostroph_comments
    - include: brace_comments
    # как в comment_after_colon: '@'-спецы после `end !` — тот же токен
    # avs_speccomments, но вариант end (pop ещё и по `&`: хвост после `end` —
    # noteString, и разделитель statement'ов его заканчивает)
    - include: special_comments_end
    - match: (?=&|\}|{{nr}}|$)
      pop: true

  # --- Состояния «внутри» комментария: "…", '…', {…} ---
  # Один ИМЕНОВАННЫЙ контекст структуры используют и обычные комментарии
  # (comment_tail_common, comment_after_colon/else/end), и мёртвый регион
  # else/elseif (dead_code_comment). Все три ЖИВУТ ЧЕРЕЗ ПЕРЕНОСЫ СТРОК: литерал
  # QSP бывает многострочным, {…} — блочная структура комментария. Совпадений на
  # «прочий текст» не нужно: пока состояние на вершине стека, текст остаётся под их
  # meta_scope. Поэтому `}` внутри "…" не закрывает {…}-блок, а `&`/`end` внутри
  # незакрытого литерала не рвут комментарий/мёртвый регион.
  comment_in_quote:
    - meta_scope: comment.qsp
    - match: '{{quote}}'
      scope: comment.qsp
      pop: true

  comment_in_apostroph:
    - meta_scope: comment.qsp
    - match: '{{ap}}'
      scope: comment.qsp
      pop: true

  comment_in_brace:
    - meta_scope: comment.qsp
    - match: '\}'
      scope: punctuation.definition.comment.end.qsp brace_comment_end.qsp
      pop: true
    - match: '\{'
      scope: punctuation.definition.comment.begin.qsp brace_comment_start.qsp
      push: comment_in_brace
    - match: '{{quote}}'
      push: comment_in_quote
    - match: '{{ap}}'
      push: comment_in_apostroph

  # вложенные {…} в комментарии (вход в comment_in_brace)
  brace_comments:
    - match: '\{'
      scope: punctuation.definition.comment.begin.qsp brace_comment_start.qsp
      push: comment_in_brace

  # "…" / '…' в комментарии (вход в состояния литералов)
  quote_apostroph_comments:
    - match: '{{quote}}'
      scope: comment.qsp
      push: comment_in_quote
    - match: '{{ap}}'
      scope: comment.qsp
      push: comment_in_apostroph

  # --- Спецкомментарий `!@` ----------------------------------------------
  # `!@` — ВАРИАНТ обычного комментария, а НЕ отдельная конструкция: те же точки
  # входа, те же завершители и та же внутренняя структура ("…"/'…'/{…}); отличается
  # ТОЛЬКО окраской тела — markup.italic + avs_speccomments. Внутренние состояния
  # не дублируются: тело подключает существующую машинерию комментария.
  # Маркер ловится В ТЕЛЕ (lookbehind `!`), а не головой: `!` на всех сайтах уже
  # съеден головой комментария, а после `end` и в мёртвом регионе головы нет вовсе.
  # Тел ТРИ — по набору завершителей САЙТА (push-тело перекрывает внешнее, поэтому
  # завершители должны повторять завершители тела-хозяина): line (newline/$),
  # braced (+ `(?=\})`: comments_in_brace), end (+ `&`/`}`: comment_after_end_in_brace).
  special_comments_line:
    - match: '(?<=\!)@'
      scope: punctuation.definition.comment.begin.qsp avs_speccomments
      push: special_comment_body_line

  special_comments_braced:
    - match: '(?<=\!)@'
      scope: punctuation.definition.comment.begin.qsp avs_speccomments
      push: special_comment_body_braced

  special_comments_end:
    - match: '(?<=\!)@'
      scope: punctuation.definition.comment.begin.qsp avs_speccomments
      push: special_comment_body_end

  special_comment_body_line:
    - meta_scope: comment.qsp markup.italic.qsp avs_speccomments
    # POP НУЛЕВОЙ ШИРИНЫ (`?=`): newline НЕ съедаем — иначе тело-хозяин
    # (comment_after_colon / comment_after_else) своего newline-pop'а уже
    # не увидит и проглотит следующую строку.
    - match: (?={{nr}}|$)
      pop: true
    - include: quote_apostroph_comments
    - include: brace_comments

  special_comment_body_braced:
    - meta_scope: comment.qsp markup.italic.qsp avs_speccomments
    - match: (?=\})
      pop: true
    # как в line-варианте: newline не съедаем (pop нулевой ширины)
    - match: (?={{nr}}|$)
      pop: true
    - include: quote_apostroph_comments
    - include: brace_comments

  special_comment_body_end:
    - meta_scope: comment.qsp markup.italic.qsp avs_speccomments
    - include: quote_apostroph_comments
    - include: brace_comments
    - match: (?=&|\}|{{nr}}|$)
      pop: true

  preprocessor:
    # lazy `.*?` перед `$` избыточен (движок всё равно доходит до конца строки).
    - match: ^(\!@pp\:.*)$
      captures:
        1: meta.preprocessor.qsp diff.deleted.qsp avs_preprocessor
        #2: markup.bold preprocessor.avs

  # Документация локации (`!@ #…`): в qsp_grammar.peg такого синтаксиса нет — это
  # соглашение корпуса, правила только оформительские. `...` — ЛИТЕРАЛЬНОЕ многоточие
  # (не «три любых символа»); вокруг — горизонтальные `[ \t]*` (`\s*` нельзя — склеил бы строки).
  qspdocs:
    - match: (?:^\!@\s)([#$%](\d+|r)[ \t]*\.\.\.[ \t]*[#$%](\d+|r))(\s+\-\s+)(.*$)
      scope: meta.diff meta.gametext.qsp
      captures:
        1: entity.other.attribute-name.documentation.qsp
    - match: (?:^\!@\s)([#$%](\d+|r))(\s+\-\s+)(.*$)
      scope: meta.diff meta.gametext.qsp
      captures:
        1: entity.other.attribute-name.documentation.qsp

  # # # ---------- фигурные скобки --------------- # # #
  figure_brace:
    - match: '\{'
      scope: punctuation.section.block.begin.qsp avs_brace_begin
      push:
        - meta_content_scope: meta.block.qsp
        # `--` внутри незакрытой `{` — ошибка (зеркало wrongclose: красим конец
        # локации и закрываем один уровень)
        - include: wrongclose_locend
        - include: htmlsupport
        - include: continuation_tail
        # Внутри открытого {…} тело uses brace-aware версию: «}» на
        # строке-комментарии (и после end) закрывает блок, а не ошибка.
        - include: location_body_braced
        - match: '\}'
          scope: punctuation.section.block.end.qsp avs_brace_end
          pop: true

  # # # ------- круглые и квадратные скобки (многострочный код) ------- # # #
  # push только если после открывающей скобки на ЭТОЙ ЖЕ строке нет закрывающей
  # (скобки в кавычках/апострофах «пропускаются»). Сбалансированные в одной строке
  # скобки обрабатываются построчными правилами.
  # NB: внутри regex не используем \xNN — Oniguruma в UTF-8 падает; кавычки — через {{ap}}/{{quote}}.
  # NB: «пропускаемая строка» в lookahead'е исключает СВОЙ разделитель (кавычки —
  # кавычку, апострофы — апостроф). Копипаст с чужим классом ломал распознавание
  # `"…'…"` → незакрытая `(`/`[` на такой строке не виделась (многострочность терялась).
  brackets_multiline:
    - match: '\((?=(?:[^{{ap}}{{quote}})\n]|{{ap}}[^{{ap}}\n]*{{ap}}|{{quote}}[^{{quote}}\n]*{{quote}})*{{nr_lookahead}})'
      scope: punctuation.section.parens.begin.qsp avs_paren_begin
      push: multiline_round
    - match: '\[(?=(?:[^{{ap}}{{quote}}\]\n]|{{ap}}[^{{ap}}\n]*{{ap}}|{{quote}}[^{{quote}}\n]*{{quote}})*{{nr_lookahead}})'
      scope: punctuation.section.brackets.begin.qsp avs_bracket_begin
      push: multiline_square

  multiline_round:
    - meta_content_scope: meta.group.parens.multiline.qsp
    - match: '\)'
      scope: punctuation.section.parens.end.qsp avs_paren_end
      pop: true
    # `--` внутри незакрытой `(` — ошибка (до правила-продолжения)
    - include: wrongclose_locend
    # продолжение выражения на новой строке: съедаем отступ перед
    # оператором/запятой/амперсандом, чтобы правила вида (^\s*?|\&\s*?|\K…)
    # «без левого операнда» не срабатывали ложно на перенесённой строке
    - match: ^\s+(?=[+\-*\/<>=,&])
      scope: meta.continuation.expression.qsp
    - include: continuation_tail
    - include: brackets_multiline
    - include: location_body

  multiline_square:
    - meta_content_scope: meta.group.brackets.multiline.qsp
    - match: '\]'
      scope: punctuation.section.brackets.end.qsp avs_bracket_end
      pop: true
    # `--` внутри незакрытой `[` — ошибка (до правила-продолжения)
    - include: wrongclose_locend
    - match: ^\s+(?=[+\-*\/<>=,&])
      scope: meta.continuation.expression.qsp
    - include: continuation_tail
    - include: brackets_multiline
    - include: location_body

  # # # ------- круглые и квадратные скобки (ОДНОстрочный код) ------- # # #
  # Сбалансированные в одной строке скобки: здесь ТОЛЬКО пунктуация, без push и без
  # meta-группы (состояние стека не меняется). «Многострочность» определяет
  # brackets_multiline (он стоит раньше — body_common_head).
  brackets_inline:
    - match: '\('
      scope: punctuation.section.parens.begin.qsp avs_paren_begin
    - match: '\)'
      scope: punctuation.section.parens.end.qsp avs_paren_end
    - match: '\['
      scope: punctuation.section.brackets.begin.qsp avs_bracket_begin
    - match: '\]'
      scope: punctuation.section.brackets.end.qsp avs_bracket_end

  # Оператор/запятая в КОНЦЕ строки внутри многострочных скобок: выражение продолжается
  # на следующей строке. Sublime матчит только в границах текущей строки, поэтому negative
  # lookahead проверок «нет правого операнда» не видит операнд со следующей строки и ложно
  # считает ошибкой. Эти правила перехватывают такие случаи раньше operacion — только когда
  # до конца строки после оператора ничего, кроме пробелов.
  continuation_tail:
    - match: (?<={{left_operand}})\s*({{operacion_two_signs}})(?=\s*{{nr_lookahead}})
      scope: keyword.operator.two-signs.qsp
    - match: (?<={{left_operand}})\s*({{operacion_one_sign}})(?=\s*{{nr_lookahead}})
      scope: keyword.operator.one-sign.qsp
    - match: (?<={{left_operand}})\s*(,)(?=\s*{{nr_lookahead}})
      scope: punctuation.separator.comma.qsp
    - match: (?<={{left_operand}})\s*\b({{operacion_word}})\b(?=\s*{{nr_lookahead}})
      scope: keyword.operator.word.qsp

  htmlsupport: # Thanks to deathaxe
    - match: (?i)(<)(qhtml)(>)
      scope: meta.tag.html.qsp
      captures:
        1: punctuation.definition.tag.begin.html.qsp
        2: entity.name.tag.html.qsp
        3: punctuation.definition.tag.end.html.qsp
      push:
        - clear_scopes: true
        - meta_scope: markup.raw text.html.embedded.qsp
        - match: (?i)(</)(qhtml)(>)
          scope: meta.tag.html.qsp
          captures:
            1: punctuation.definition.tag.begin.html.qsp
            2: entity.name.tag.html.qsp
            3: punctuation.definition.tag.end.html.qsp
          pop: true
        - include: Packages/HTML/HTML (Plain).sublime-syntax


  separator_continuation:
    - match: '[ ]_(?=$)' # only space and underline characters in line-end. not \t.
      scope: punctuation.separator.continuation.qsp avs_longstring
