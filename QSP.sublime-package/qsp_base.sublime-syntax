%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html
#
# Quest Soft Player Language: ОБЩАЯ БАЗА подсветки тела локации.
# https://qsp.org/
#
# Этот файл — общий каркас (hidden). Его наследуют через `extends`:
#   - qsp.sublime-syntax        (формат qsps: блоки локаций + текст между ними)
#   - qsp.qsrc.sublime-syntax   (формат qsrc: один файл = одна локация)
# В базе живёт ВСЁ, что общее для форматов: подсветка кода тела локации.
# Разнятая у форматов логика (main, границы локации, текст между локациями,
# заголовок QSP-Game) — НЕ в базе, а в самих форматах.

name: QSP (base)
hidden: true
scope: source.qsp.base
version: 2

variables: # назначаем переменные для удобства
  kw_statements: |- # keyword.statement
    (?ix:
      inclib|freelib|openqst|opengame|savegame|
      addobj|delobj|killobj|modobj|resetobj|unsel|unselect|
      cls|
      cla|delact|
      cmdclr|cmdclear|
      play|close\sall|close|
      jump|dynamic|goto|gt|xgoto|xgt|gosub|gs|menu|exit|
      showobjs|showstat|showacts|showinput|refint|
      copyarr|sortarr|setvar|insvar|unpackarr|killvar|killall|scanstr|
      view|msg|
      settimer|wait|
      # exec: отсутствует в qsp_grammar.peg (упущение грамматики, не правим её),
      # но поддерживается движком и нужен в подсветке — НЕ убирать.
      exec
    )
  kw_controls: (?i:act|if|elseif|else|loop|while|step|end) # keyword.control
  kw_text_statements: (?i:pl?|nl|clr|clear) # keyword.statement
  system_vars_num: (?i:nosave|disablescroll|debug|usehtml|(b|f|l)color|fsize)
  system_vars_string: (?i:counter|ongload|ongsave|onnewloc|onactsel|onobjsel|onobjadd|onobjdel|usercom|fname|backimage)
  system_vars: (?i:args|result)
  functions_num: |- # variable.function
    (?ix:
      loc|obj|isnum|isplay|
      len|val|instr|strcomp|strpos|
      arrsize|arrpos|arrcomp|
      msecscount|
      rgb|
      countobj|
      ra?nd
    )
  functions_string: |- # variable.function
    (?ix:
      desc|user_text|usrtxt|maintxt|stattxt|
      curloc|selobj|selact|
      mid|(u|l)case|trim|replace|str|strfind|
      input|
      qspver|
      curacts|curobjs|
      getobj|
      arrtype|arrkey
    )
  functions_tuple: |- # variable.function
    (?ix:
      arrpack
    )
  functions_alltypes: (?i:iif|dyneval|func|max|min|arritem) # variable.function
  quote: '"'
  ap: "'"
  left_operand: '({{quote}}|{{ap}}|\)|\}|\$|\%|\?|\w|\d)'
  right_operand: '({{quote}}[^{{quote}}]*|{{ap}}[^{{ap}}]*|\([^\)]*?|\[[^\]]*?|\{|((\$|\%|\#)?|-?)\w+?|-?\d+?|\@|\?)'
  nr: (\n\r|\r|\r\n|\n)
  nr_lookahead: (?=\r\n|\r|\n|$)
  # Фаза 7: «в заголовке есть НЕзакрытая на этой строке ( или [ » — признак
  # многострочной скобки, из-за которой ':' уезжает на другую строку. Условие
  # требует наличия открывающей скобки, после которой на ЭТОЙ строке нет ни ')' ни ']'.
  # Закрытием такой скобки штатно занимается multiline_round.
  unbalanced_bracket_head: (?=[^\n]*?[\(\[](?![^\n]*?[\)\]])[^\n]*?{{nr_lookahead}})
  # NB (fidelity к qsp_grammar.peg, п.6.3): двухзначные операторы `=<` и `=>`
  # (grammar `binaryStandardOperator`) намеренно НЕ поддержаны — `operacion_two_signs`
  # ловит только `<= >= += -= *= /= <>`. `=<`/`=>` подсветятся как два one-sign'а.
  operacion_two_signs: ([<>\+\-\*\/]=|<>)
  operacion_one_sign: (\+|-|<|>|=|\/|\*|!)
  operacion_word: (?i:and|or|mod)
  # users_variables: имя переменной = все Unicode-буквы, цифры, подчёркивание и точка
  # (fidelity к grammar varName, п.6.7): первый символ — буква/`_` (не цифра, grammar
  # `~digit`), далее `\p{L}` (любая буква), `\d`, `_`, `.`. Прочие символы — нельзя.
  # NB: требует поддержки `\p{L}` в Onigmo Sublime — проверить ручным рендером.
  users_variables: '((\$|\%|\#)?[\p{L}_][\p{L}\d_.]*)'
  elseif_else_final: (?i:\bend\b|\belse\b|\belse\s*if\b|\bif\b|(^\s*\-.*?$))

contexts: # общие контексты подсветки кода локации
  # Тривиальный вход для самой базы (база hidden, реально используется
  # только через extends из форматов qsps/qsrc, у которых свой main).
  main:
    - include: location_body

  # Тело локации — два формата (plain вне {…} и braced внутри {…}).
  # После п.2.3 фаза-2 общие include-сегменты вынесены в body_common_*;
  # различаются форматы лишь 4 позициями (actions/conditions/loop и comments).
  # Вложенный `include` вставляет правила referenced-контекста на место —
  # порядок/приоритет matching сохранены 1:1 (фаза 1 поведение не меняла).
  body_common_head:
    - include: figure_brace
    - include: brackets_multiline
  body_common_mid:
    - include: kw_declarations
    - include: sugargosub
    - include: sugarfunc
    - include: wrong_end_else_elseif
    - include: preprocessor
  body_common_tail:
    - include: location_call
    - include: jump_to_label
    - include: labels
    - include: statements
    - include: operacion
    - include: system_variables
    - include: functions
    - include: numeric
    - include: strings
    - include: separator_continuation
    - include: users_variables

  location_body:
    # Порядок (Фаза 7): открыватели блоков act/if/loop ИДУТ ПЕРЕД body_common_head,
    # чтобы «bracket-arm» заголовка не проигрывал приоритет незакрытой «(» в
    # brackets_multiline. Для строк, не начинающихся с ключевого слова,
    # figure_brace/brackets_multiline отработают в своём include позже — 1:1.
    - include: multiline_actions
    - include: multiline_conditions
    - include: multiline_loop
    - include: body_common_head
    - include: body_common_mid
    - include: comments
    - include: body_common_tail

  # Тело локации ВНУТРИ открытого {…} блока. Полный зеркальный список
  # location_body, но с brace-aware варианами:
  #   comments → comments_in_brace (закрывающая «}» строки-комментария
  #              не помечается ошибкой, а закрывает блок);
  #   multiline_actions/conditions/loop → *_braced (тело — снова
  #              location_body_braced). После п.2.1 фаза-2 «end» в обоих
  #              форматах ведёт единый comment_after_end_in_brace.
  # figure_brace остаётся общим: вложенная «{» открывает новый braced-блок.
  location_body_braced:
    # См. порядок в location_body (Фаза 7): открыватели блоков до body_common_head.
    - include: multiline_actions_braced
    - include: multiline_conditions_braced
    - include: multiline_loop_braced
    - include: body_common_head
    - include: body_common_mid
    - include: comments_in_brace
    - include: body_common_tail

  # пользовательские переменные и специальные символы значений
  users_variables:
    # ? — символ дефолтного значения (QSP 5.8+), подсвечивается как пользовательская переменная
    - match: '\?'
      scope: meta.user-variables.qsp variable.language.default.qsp
    - match: '{{users_variables}}(?=\s*\b(while|step|else|elseif|and|or|mod)\b)'
      scope: meta.user-variables.qsp
    - match: '{{users_variables}}(?=(\s+{{right_operand}}|\s*\({{right_operand}}))'
      scope: invalid.illegal.qsp meta.wrong_statement.qsp
    - match: '{{users_variables}}'
      scope: meta.user-variables.qsp

  # Прыжок на метку
  jump_to_label:
    - match: (jump)(?=\s*($|&))
      scope: invalid.illegal.qsp
    - match: (jump)\s*(('|").*?\3)
      captures:
        1: keyword.statement.qsp avs_statements
        2: string.quoted.double.qsp label_to_jump.qsp

  # вызовы локаций
  location_call:
    - match: (goto|gt|xgoto|xgt|gosub|gs)(?=\s*($|&))
      scope: invalid.illegal.qsp
    - match: (goto|gt|xgoto|xgt|gosub|gs)\s*(('|").*?\3)
      captures:
        1: keyword.statement.qsp avs_statements
        2: string.quoted.double.qsp callable_locs.qsp
    - match: (func)(\()(('|").*?\4)
      captures:
        1: support.function.qsp
        3: string.quoted.double.qsp callable_locs.qsp

  # NB (fidelity к qsp_grammar.peg, п.6.3): имя пользователя матчается `[\w\.\#]+`
  # — намеренно БЕЗ кириллицы и `$`/`%` (grammar `nonDelimiterChar+` шире).
  sugargosub:
    - match: (\@\@)([\w\.\#]+)
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp

  # неявный вызов функций
  sugarfunc:
    - match: (\@)([\w\.\#]+)(?=\s*\()
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp markup.italic.qsp
    - match: (\@)([\w\.\#]+)(?=\s*\b(while|step|else|elseif|and|or|mod)\b)
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp markup.italic.qsp
    - match: (\@[\w\.\#]+\s+{{right_operand}})
      scope: invalid.illegal.qsp markup.italic.qsp
    - match: (\@)([\w\.\#]+)
      captures:
        1: punctuation.definition.function.qsp support.function.builtin.qsp
        2: variable.function.qsp markup.italic.qsp

  # действия (Фаза 2, п.2.1: former arms `(?<=\{)act` + `^act` слиты через
  # НЕ-захватывающую alternation якорей `(?:^|(?<=\{))` (оба якоря нулевой
  # ширины) — единая группа `(\s*?)`=group1, ключ. слово=group2, номера capture
  # сохранены в обеих ветках). Branch-reset `(?|…)` НЕ используем — эта сборка
  # Onigmo его не поддерживает ("undefined group option").
  # Единый end-tail = comment_after_end_in_brace (brace-aware модель едина для
  # обоих якорей — см. REFACTOR_PLAN §3 Решение-1; на верхнем уровне
  # разница видна только для редкого `end текст }`).
  multiline_actions:
    - match: '(?:^|(?<=\{))(\s*?)(?i:(act))(?=\s*?.*?\:\s*?(!.*?)?$)'
      scope: meta.begin_action.qsp
      captures:
        2: keyword.control.action.begin.qsp markup.italic.qsp
      push:
        - include: comment_after_colon
        - match: ^(\s*?)(?i:(\bend\b))
          scope: meta.end-action.qsp
          captures:
            2: keyword.control.action.end.qsp markup.italic.qsp
          pop: true
          push: comment_after_end_in_brace
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body

  # циклы (п.2.1: former `(?<=\{)loop` + `^loop` слиты; пуш-тело было идентично)
  multiline_loop:
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\bloop\b))(?=.*?(?i:(\bwhile\b))\s\S.*?(?i:(\bstep\b))?\s*?.*?\:\s*?(!.*)?$)'
      scope: meta.begin_cycle.qsp
      captures:
        2: keyword.control.cycle.begin.qsp markup.italic.qsp
      push:
        - include: comment_after_colon
        - match: ^(\s*?)(?i:(\bend\b))
          captures:
            2: keyword.control.cycle.end.qsp markup.italic.qsp
          pop: true
          push: comment_after_end_in_brace
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body
    - match: '(?i:(\bloop\b))(?!.*(?i:(\bwhile\b)))'
      scope: invalid.illegal.qsp

  # конструкции условий (п.2.1: former `(?<=\{)if` + `^if` слиты)
  multiline_conditions:
    # strict-arm: ':' на строке if → сразу тело
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\bif\b))(?=\s*?.*?\:\s*?(!.*)?$)'
      captures:
        2: keyword.control.conditional.begin.qsp markup.italic.qsp
      push: multiline_conditions_body
    # bracket-arm (Фаза 7): многострочная ( или [ в заголовке if — из-за неё ':'
    # уехал за пределы строки ключевого слова и strict-arm не срабатывает. Открываем
    # блок сразу; незакрытую скобку доедает location_body (brackets_multiline →
    # multiline_round), ':' на строке закрытия обрабатывает тот же location_body.
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\bif\b)){{unbalanced_bracket_head}}'
      captures:
        2: keyword.control.conditional.begin.qsp markup.italic.qsp
      push: multiline_conditions_body

  # тело if-конструкции (Фаза 7: вынесено из inline-push strict-arm, поведение 1:1;
  # используют оба arm'а).
  multiline_conditions_body:
    - include: comment_after_colon
    - match: ^(\s*?)(?i:(\bend\b))
      captures:
        2: keyword.control.conditional.end.qsp markup.italic.qsp
      pop: true
      push: comment_after_end_in_brace
    - include: multiline_actions_elseif
    - include: multiline_actions_else
    - include: wrongclose
    - include: wrong_close_in_brace
    - include: location_body

  wrong_end_else_elseif:
    - match: (?i:(\bend\b)) # подсветка лишнего end'а
      scope: invalid.illegal.qsp meta.excess_end.qsp
    - match: ^(?:\s*?)(?i:(\belse\b)) # лишний else
      scope: invalid.illegal.qsp meta.excess_else.qsp
    - match: ^(?:\s*?)(?i:(\belseif\b)) # elseif работает только в многострочной форме (исправить, если изменится в 5.8.0)
      scope: invalid.illegal.qsp meta.excess_elseif.qsp

  # Ошибочные закрытия контейнеров (п.3.3): порядок include'ов зафиксирован —
  # «сначала ошибки, потом тело» (wrongclose → wrong_close_in_brace →
  # location_body[_braced]). Правила ловят РАЗНЫЕ символы в непересекающихся
  # позициях (`-` в начале строки против `}` где угодно), поэтому взаимный
  # порядок wrongclose/wrong_close_in_brace на matching не влияет — но он
  # ЕДИНОЙ душой везде и менять его по отдельности нельзя.
  # wrongclose: «-» в начале строки внутри незакрытого act/loop/if —
  # ложный признак конца локации.
  wrongclose:
    - match: ^\s*?(-)(.*)({{nr}}$|$)
      scope: invalid.illegal.qsp
      pop: true

  # wrong_close_in_brace: «}» внутри незакрытой конструкции (контейнер ещё
  # не дописан) — ошибка и выход из контейнера. НАМЕРЕНИЕ (REFACTOR_PLAN §1C.3):
  # согласовано с семантикой «незакрытая конструкция = ошибка».
  wrong_close_in_brace:
    - match: \}(.*)({{nr}}$|$)
      scope: invalid.illegal.qsp avs_error avs_wrongelse1
      pop: true

  # else (п.2.1): arms «голый else» и «else с хвостом-комментарием» слиты по
  # якорям через branch-reset; две формы после двоеточия (строгая `^else:` и
  # разрешающая условие `{else x:`) оставлены раздельно — у них разные
  # language-sets, слияние изменило бы семантику ошибок.
  multiline_actions_else:
    - match: ^\s*?(?i:(\belse\b))(\s*?)([^\:]+)(\:).*$
      scope: invalid.illegal.qsp meta.wrong_else_conditional.qsp
    - match: '^(\s*?)(?i:(\belse\b))(?=\s*?\:\s*?(!.*)?$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: comment_after_colon
        - include: illegal_multiline_else
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body
    - match: '(?<=\{)(\s*?)(?i:(\belse\b))(?=\s*?.*?\:\s*?(!.*)?$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: comment_after_colon
        - include: illegal_multiline_else
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\belse\b))\s*(:?)(?=\s*([^!\s].*)?$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
        3: punctuation.definition.keyword
      push:
        - include: illegal_multiline_else
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - match: "^.*"
          scope: comment.qsp
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body
    - match: '^(\s*?)(?i:(\belse\b))(?=\s*$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: illegal_multiline_else
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body

  illegal_multiline_else:
    - match: (?:^\s*)(?i:\belse\b)
      scope: invalid.illegal.qsp meta.excess_multiline_else.qsp

  # elseif (п.2.1): пары `^`/{`-arms слиты через branch-reset; тела были
  # идентичны с точностью до порядка comment_after_colon/final-guard —
  # приведены к порядку comment-первым (guard — нулевой ширины, на
  # середине строки не срабатывает, так что порядок comment_after_colon
  # внутри одного пуша не менял matching для обеих веток).
  multiline_actions_elseif:
    # `else if` (grammar `elseIfSpaceMarker = "else" ws "if"`) трактуется как ЕДИНЫЙ
    # elseif-оператор: `\b(?:else\s+if|elseif)\b` внутри прежней capture-группы
    # (нумерация групп сохранена — внутренняя alternation не захватывающая).
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\b(?:else\s+if|elseif)\b))(?=\s+\S.*?\:\s*(!.*)?$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: comment_after_colon
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - include: location_body
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\b(?:else\s+if|elseif)\b))(?=\s+\S.*?\:\s*([^!\s].*)?$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
        3: punctuation.definition.keyword
      push:
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - match: "^.*"
          scope: comment.qsp
        - include: location_body

  # # # ------- braced-двойники контейнеров (тело внутри {…}) ------- # # #
  # Зеркала multiline_actions / multiline_loop / multiline_conditions /
  # multiline_actions_else / multiline_actions_elseif. Единственное отличие:
  #   - тело пушит включения с суффиксом _braced (location_body_braced и
  #     вложенные *_braced); «end» В ОБЕИХ версиях ведёт единый
  #     comment_after_end_in_brace (Решение-1A, Фаза 3).
  # Нужны потому, что Sublime не позволяет «заглянуть в стек» и узнать,
  # открыт ли сейчас {…}-блок: признак окружения кодируется выбором
  # location_body vs location_body_braced.
  # СИНХРОН-КОНТРАКТ (Фаза 5, п.5.1): правки в multiline_* чиним зеркально
  # здесь же. Парность ПРОВЕРЯЕТСЯ АВТОМАТИЧЕСКИ: check_syntax_phase1.py
  # (_disdocs/syntax_highlighting) сверяет пары после нормализации суффикса
  # _braced — расхождение валит контроль в FAIL.
  multiline_actions_braced:
    - match: '(?:^|(?<=\{))(\s*?)(?i:(act))(?=\s*?.*?\:\s*?(!.*?)?$)'
      scope: meta.begin_action.qsp
      captures:
        2: keyword.control.action.begin.qsp markup.italic.qsp
      push:
        - include: comment_after_colon
        - match: ^(\s*?)(?i:(\bend\b))
          scope: meta.end-action.qsp
          captures:
            2: keyword.control.action.end.qsp markup.italic.qsp
          pop: true
          push: comment_after_end_in_brace
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body_braced

  multiline_loop_braced:
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\bloop\b))(?=.*?(?i:(\bwhile\b))\s\S.*?(?i:(\bstep\b))?\s*?.*?\:\s*?(!.*)?$)'
      scope: meta.begin_cycle.qsp
      captures:
        2: keyword.control.cycle.begin.qsp markup.italic.qsp
      push:
        - include: comment_after_colon
        - match: ^(\s*?)(?i:(\bend\b))
          captures:
            2: keyword.control.cycle.end.qsp markup.italic.qsp
          pop: true
          push: comment_after_end_in_brace
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body_braced
    - match: '(?i:(\bloop\b))(?!.*(?i:(\bwhile\b)))'
      scope: invalid.illegal.qsp

  multiline_conditions_braced:
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\bif\b))(?=\s*?.*?\:\s*?(!.*)?$)'
      captures:
        2: keyword.control.conditional.begin.qsp markup.italic.qsp
      push: multiline_conditions_body_braced
    # bracket-arm (Фаза 7): зеркало plain (parity 5.1).
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\bif\b)){{unbalanced_bracket_head}}'
      captures:
        2: keyword.control.conditional.begin.qsp markup.italic.qsp
      push: multiline_conditions_body_braced

  # зеркало multiline_conditions_body: тело пушит location_body_braced и
  # brace-aware else/elseif. comment_after_end_in_brace — общий (Решение-1A).
  multiline_conditions_body_braced:
    - include: comment_after_colon
    - match: ^(\s*?)(?i:(\bend\b))
      captures:
        2: keyword.control.conditional.end.qsp markup.italic.qsp
      pop: true
      push: comment_after_end_in_brace
    - include: multiline_actions_elseif_braced
    - include: multiline_actions_else_braced
    - include: wrongclose
    - include: wrong_close_in_brace
    - include: location_body_braced

  multiline_actions_else_braced:
    - match: ^\s*?(?i:(\belse\b))(\s*?)([^\:]+)(\:).*$
      scope: invalid.illegal.qsp meta.wrong_else_conditional.qsp
    - match: '^(\s*?)(?i:(\belse\b))(?=\s*?\:\s*?(!.*)?$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: comment_after_colon
        - include: illegal_multiline_else
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body_braced
    - match: '(?<=\{)(\s*?)(?i:(\belse\b))(?=\s*?.*?\:\s*?(!.*)?$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: comment_after_colon
        - include: illegal_multiline_else
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body_braced
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\belse\b))\s*(:?)(?=\s*([^!\s].*)?$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
        3: punctuation.definition.keyword
      push:
        - include: illegal_multiline_else
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - match: "^.*"
          scope: comment.qsp
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body_braced
    - match: '^(\s*?)(?i:(\belse\b))(?=\s*$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: illegal_multiline_else
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - include: wrongclose
        - include: wrong_close_in_brace
        - include: location_body_braced

  multiline_actions_elseif_braced:
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\b(?:else\s+if|elseif)\b))(?=\s+\S.*?\:\s*(!.*)?$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
      push:
        - include: comment_after_colon
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - include: location_body_braced
    - match: '(?:^|(?<=\{))(\s*?)(?i:(\b(?:else\s+if|elseif)\b))(?=\s+\S.*?\:\s*([^!\s].*)?$)'
      captures:
        2: keyword.control.conditional.else.qsp markup.italic.qsp meta.else_body.qsp
        3: punctuation.definition.keyword
      push:
        - match: (?=^\s*{{elseif_else_final}}([^\&\n\r]*))
          pop: true
        - match: "^.*"
          scope: comment.qsp
        - include: location_body_braced

  # set и local
  kw_declarations:
      # ([A-Za-zА-Яа-я_][\w\.]*)
    - match: \b(?i:(local))\b(?=\s+{{users_variables}}(\[.*?\])?(\,\s*{{users_variables}}(\[.*?\])?)*(\s*\=\s*.+)?\s*(?i:(\&|{{nr}}|\}|\bwhile\b)))
      scope: keyword.declaration.variables.qsp
    - match: \b(?i:(set|let))\b(?=\s+{{users_variables}}(\[.*?\])?(\,\s*{{users_variables}}(\[.*?\])?)*(\s*\=\s*.+)\s*(?i:(\&|{{nr}}|\}|\bwhile\b)))
      scope: keyword.declaration.variables.qsp
    - match: \b(?i:set|local|let)\b
      scope: invalid.illegal.qsp

  # операции (Решение-4/4B: построчно идентичные сегменты `operacion`
  # и `operacion_subex` вынесены в operacion_word_two_signs_common и
  # operacion_ampersand_common; реально различающиеся группы — one_sign
  # (unary `-` / `>`-exclusion / lookbehind-vs-\K), comma with_out_left,
  # регистр `no` — оставлены локально; их слияние изменило бы подсветку.
  operacion_word_two_signs_common:
    # подсветка словарных операторов
    - match: (?<={{left_operand}})\s*\b{{operacion_word}}\b(?!\s*?{{right_operand}})
      scope: invalid.illegal.qsp avs_wrong_word_with_out_right
    - match: (?<=^|\&|\(|\{|\[)\s*\b{{operacion_word}}\b(?=\s*?{{right_operand}}*)
      scope: invalid.illegal.qsp avs_wrong_word_with_out_left
    - match: \b{{operacion_word}}\b 
      scope: keyword.operator.word.qsp
    # подсветка двузнаковых операторов
    - match: (?<={{left_operand}})\s*?{{operacion_two_signs}}(?!\s*?{{right_operand}})
      scope: invalid.illegal.qsp avs_wrong_two_signs_with_out_right
    - match: (^\s*?|\&\s*?|\(\s*?|\{\s*?|\[\s*?)\K{{operacion_two_signs}}(?=\s*?{{right_operand}}*)
      scope: invalid.illegal.qsp avs_wrong_two_signs_with_out_left
    - match: (?<={{left_operand}})\s*?{{operacion_two_signs}}(?=\s*?{{right_operand}})
      scope: keyword.operator.two-signs.qsp

  operacion_ampersand_common:
    # Правила для амперсандов
    - match: (^\s*?|\(\s*?|\{\s*?|\[\s*?)\K(\&)(?=\s*?{{right_operand}}*)
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_left
    - match: \&
      scope: keyword.operator.ampersand.qsp

  operacion:
    - include: operacion_word_two_signs_common
    # подсветка для однознаковых операторов
    - match: '\-(?=\s*?{{right_operand}})'
      scope: keyword.operator.one-sign.qsp
    - match: (?<={{left_operand}})\s*?{{operacion_one_sign}}(?!\s*?{{right_operand}})
      scope: invalid.illegal.qsp avs_wrong_one_sign_with_out_right
    - match: (^\s*?|\&\s*?|\(\s*?|\{\s*?|\[\s*?)\K{{operacion_one_sign}}(?=\s*?{{right_operand}}*)
      scope: invalid.illegal.qsp avs_wrong_one_sign_with_out_left
    - match: '{{operacion_one_sign}}'
      scope: keyword.operator.one-sign.qsp
    # Правила для запятых
    - match: (?<={{left_operand}})\s*?(,)(?!\s*?{{right_operand}})
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_right
    - match: (^\s*?|\&\s*?|\(\s*?|\{\s*?|\[\s*?)\K(,)(?=\s*?{{right_operand}}*)
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_left
    - match: (,)
      scope: punctuation.separator.comma.qsp
    - include: operacion_ampersand_common
    # Правила для no
    - match: (?i:\bno\b)(?!\s*?{{right_operand}})
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_left
    - match: (?i:\bno\b)
      scope: keyword.operator.word.qsp

  numeric:
    - match: \b\d+([A-Za-zа-яА-Я\$\%\._]+\d*)+\b # неправильные переменные, начинающиеся с цифр
      scope: invalid.illegal.qsp avs_wrong_numeric
    - match: \b[0-9]+\b
      scope: constant.numeric avs_numeric

  statements:
    # подсветка statement'ов
    - match: (\b({{kw_statements}}|{{kw_text_statements}})\b)(?!\()
      scope: keyword.statement.qsp avs_statements
    - match: (\b({{kw_statements}})\b)(?=\()
      scope: support.function.other.qsp avs_statements
    - match: (\*)(\b({{kw_text_statements}})\b)(?=\()
      captures:
        1: support.function.star.qsp punctuation.definition.function
        2: support.function.other.qsp avs_statements
    - match: (\*)(?={{kw_text_statements}}\b)
      scope: keyword.statement.star.qsp punctuation.definition.keyword avs_star
    - match: \b{{kw_controls}}\b
      scope: keyword.control.qsp markup.italic.qsp
    - match: (\*)(?={{kw_statements}}\b)
      scope: invalid.illegal.qsp avs_wrong_star_statements
    - match: (\*)(?={{kw_controls}}\b)
      scope: invalid.illegal.qsp avs_wrong_star_controls

  system_variables:
    - match: (%)(\b{{system_vars_string}}\b)
      scope: invalid.illegal.qsp avs_illegal_textvariables
    # # — числовой префикс перед строковой системной переменной → ошибка
    - match: (\#)(\b{{system_vars_string}}\b)
      scope: invalid.illegal.qsp avs_illegal_textvariables

    - match: |-
        (?x:
          ({{system_vars}}|{{system_vars_string}})
          (?=(\s+{{right_operand}}|\s*\({{right_operand}}))
        )
      scope: invalid.illegal.qsp

    - match: |-
        (?x:
          ({{system_vars}}|{{system_vars_string}})
          (?=\$({{system_vars}}|{{system_vars_string}}))
        )
      scope: invalid.illegal.qsp avs_illegal_textvariables

    - match: (?<=[\w\.\$]\$)({{system_vars}}|{{system_vars_string}})
      scope: invalid.illegal.qsp avs_illegal_textvariables

    - match: (\$)(?=\b({{system_vars_string}}|{{system_vars}})\b)
      scope: variable.language.qsp punctuation.definition.variable avs_sysvar

    - match: (\%)(?=\b({{system_vars}})\b)
      scope: variable.language.qsp punctuation.definition.variable avs_sysvar
    # # — числовой префикс перед числовой системной переменной → верно
    - match: (\#)(?=\b({{system_vars_num}})\b)
      scope: variable.language.qsp punctuation.definition.variable avs_sysvar
    # # — числовой префикс перед системной переменной любого типа → верно
    - match: (\#)(?=\b({{system_vars}})\b)
      scope: variable.language.qsp punctuation.definition.variable avs_sysvar

    - match: \b({{system_vars_num}}|{{system_vars_string}}|{{system_vars}})\b
      scope: variable.language.qsp avs_sysvar

      # подсвечивает символ доллара перед названием числовых переменных
    - match: (\$|%)(?={{system_vars_num}}\b)
      scope: invalid.illegal.qsp avs_illegal_$

  functions:
      # # — числовой префикс перед строковой функцией → ошибка типа
    - match: (\#)(?=\b{{functions_string}}\b)
      scope: invalid.illegal.qsp avs_wrong_type_prefix
      # # — числовой префикс перед кортежной функцией → ошибка типа
    - match: (\#)(?=\b{{functions_tuple}}\b)
      scope: invalid.illegal.qsp avs_wrong_type_prefix
      # правильно подсвечивает префикс типа перед строковыми функциями
    - match: (\$)(?=({{functions_string}}\b|{{functions_alltypes}}\b))
      scope: support.function.qsp punctuation.definition.function avs_function
      # правильно подсвечивает префикс типа перед кортежными функциями
    - match: (\%)(?=({{functions_tuple}}\b|{{functions_alltypes}}\b))
      scope: support.function.qsp punctuation.definition.function avs_function
      # # — числовой префикс перед числовой/универсальной функцией → верно
    - match: (\#)(?=({{functions_num}}\b|{{functions_alltypes}}\b))
      scope: support.function.qsp punctuation.definition.function avs_function
      # подсветка непосредственно названий функций
    - match: |-
        (?x:
          \b(
          {{functions_num}}|
          {{functions_string}}|
          {{functions_tuple}}|
          {{functions_alltypes}}
          )\b
        )
      scope: support.function.qsp avs_function
      # подсвечивает префикс типа перед названием числовых функций
    - match: (\$|\%)(?=\b{{functions_num}}\b)
      scope: invalid.illegal.qsp avs_wrong_type_prefix
      # подсвечивает префикс % перед названием строковых функций
    - match: (\%)(?=\b{{functions_string}}\b)
      scope: invalid.illegal.qsp avs_wrong_type_prefix
      # подсвечивает префикс $ перед названием кортежных функций
    - match: (\$)(?=\b{{functions_tuple}}\b)
      scope: invalid.illegal.qsp avs_wrong_type_prefix

  # NB (fidelity к qsp_grammar.peg, п.6.3): grammar `noteChar` исключает `()[]{}`
  # из метки, но ВСЕ МЕТКИ ОДНОСТРОЧНЫ — многострочные скобки внутри метки не нужны,
  # поэтому подсветка намеренно ДОПУСКАЕТ скобки (шире grammar; не является ошибкой).
  labels:
    - match: ^(\s*?\:|\:)([^&'"\n]+)
      captures:
        2: entity.name.qlabel.qsp avs_jumps_labels

  # # # ------------------- строки ------------------------ # # #
  # п.2.2: общий body (preprocessor+subexpression+htmlsupport) вынесен в
  # string_common; различие двух arms — только символ кавычки и правило
  # удвоения (`""`/`''`). meta_scope оставлен `string.quoted.double.qsp`
  # для обоих как прежде (поведение не меняем).
  strings:
    - match: '"'
      push:
        - meta_scope: string.quoted.double.qsp
        - match: '""'
          scope: constant.character.escape.qsp
        - match: '"'
          pop: true
        - include: string_common
    - match: "'"
      push:
        - meta_scope: string.quoted.double.qsp
        - match: "''"
          scope: constant.character.escape.qsp
        - match: "'"
          pop: true
        - include: string_common

  string_common:
    - include: preprocessor
    - include: subexpression
    - include: htmlsupport

  subexpression:
    - match: '<<'
      scope: punctuation.section.interpolation.begin.qsp avs_begin_subexpression
      push:
        - clear_scopes: true
        - meta_scope: meta.interpolation.qsp
        - meta_content_scope: source.qsp.embedded
        - match: '>>'
          scope: punctuation.section.interpolation.end.qsp avs_end_subexpression
          pop: true
        - include: subex

  subex:
    - include: figure_brace
    - include: sugarfunc
    # Многострочность подвыражения `<< … >>` (grammar `stringSubexpression` =
    # `"<<" mws multilineExpression mws ">>"`, `mws` допускает перенос) разрешена
    # ТОЛЬКО внутри скобок и вложенных строк. `brackets_multiline` пушит
    # `multiline_round`/`multiline_square`, которые поглощают переносы внутри `(`/`[
    # `; `{…}` покрыт `figure_brace`, вложенные строки — `strings`. Правило ниже
    # ловит ГОЛЫЙ перенос (вне скобок/строк) — он остаётся ошибкой.
    - include: brackets_multiline
    - match: (\n\r|\r|\r\n|\n)
      scope: invalid.illegal.qsp avs_wrongenter
    - include: operacion_subex
    - include: system_variables
    - include: functions
    - include: numeric
    - include: strings
    - include: users_variables

  operacion_subex:
    # Операции ВНУТРИ подвыражения `<< … >>` (embedded source). Общие с
    # `operacion` сегменты вынесены в operacion_word_two_signs_common /
    # operacion_ampersand_common (Решение-4/4B). Локально оставлены только
    # реально отличающиеся группы: one_sign (нет unary `-`; with_out_right
    # несёт доп. exclusion `(>…)`; with_out_left — lookbehind `(?<=(<|&|(|{|[))`
    # вместо `(^|…)\K`, т.к. здесь нет `^` строки кода), comma with_out_left
    # (тот же lookbehind) и `no` (регистрозависим, без `(?i:)`).
    - include: operacion_word_two_signs_common
    # подсветка однознаковых операторов
    - match: (?<={{left_operand}})\s*?{{operacion_one_sign}}(?!(>|\s*?{{right_operand}}))
      scope: invalid.illegal.qsp avs_wrong_one_sign_with_out_right
    - match: (?<=(<|\&|\(|\{|\[))\s*?{{operacion_one_sign}}(?=\s*?{{right_operand}}*)
      scope: invalid.illegal.qsp avs_wrong_one_sign_with_out_left
    - match: '{{operacion_one_sign}}'
      scope: keyword.operator.one-sign.qsp
    # Правила для запятых
    - match: (?<={{left_operand}})\s*?(,)(?!\s*?{{right_operand}})
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_right
    - match: (?<=(<|\&|\(|\{|\[))\s*?(,)(?=\s*?{{right_operand}}*)
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_left
    - match: (,)
      scope: punctuation.separator.comma.qsp
    - include: operacion_ampersand_common
    # Правила для no
    - match: (\bno\b)(?!\s*?{{right_operand}})
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_left
    - match: (\bno\b)
      scope: keyword.operator.word.qsp

  # # # ------------------------ Подсветка комментариев ------------------------  # # #
  # Общий хвост комментария (Фаза 3, п.3.1): тело от «!» до конца строки.
  # Используется контекстами comments и comments_in_brace (их arms различаются
  # только якорем и наличием «?\}»-попа, вынесенного в сами arms).
  # ПОРЯДОК правил внутри push-тел значим (поиск слева направо, первое
  # совпадение) — менять только вместе с анализом позиционных коллизий.
  comment_tail_common:
    - match: (\n\r|\r|\r\n|\n|$)
      scope: comment.qsp
      pop: true
    - include: quote_apostroph_comments
    - include: brace_comments
    - include: special_comments

  # Комментарий «!» — однострочный или многострочный (через &-продолжения).
  # (п.3.1) Arms НЕ слиты в один regex: ветка «^\s*?» матчит только на начале
  # строки, а «\&» — в любой позиции; общая альтернация с внешним \s*?
  # ложно расширяла бы набор позиций. Зато тело вынесено в comment_tail_common.
  comments:
    - match: (?<=\{)((\s*?)|(\&)\s*?)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - include: comment_tail_common
    - match: ((^\s*?)|(\&)\s*?)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - include: comment_tail_common

  # Комментарии внутри открытого {…} блока.
  # Отличие от comments: комментарий схлопывается НУЛЕВЫМ lookahead «(?=\})»,
  # не поглощая «}»: если на строке-комментарии стоит «}» нулевого уровня
  # вложенности (нет незакрытой вложенной «{» из brace_comments), то это
  # закрывающая скобка самого блока — её ловит правило закрытия figure_brace.
  # Внутри строковых литералов (quote_apostroph_comments) и вложенных {…}
  # (brace_comments) «}» остаётся защищённой и блок не закрывает.
  comments_in_brace:
    - match: (?<=\{)((\s*?)|(\&)\s*?)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - match: (?=\})
          pop: true
        - include: comment_tail_common
    - match: ((^\s*?)|(\&)\s*?)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - match: (?=\})
          pop: true
        - include: comment_tail_common

  comment_after_colon: # комментарии после двоеточия
    - match: (?<=:)((\s*?)|(\&)\s*?)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.begin.qsp main_comment_start.qsp
      push:
        - meta_scope: comment.qsp
        - match: (\n\r|\r|\r\n|\n|$)
          scope: punctuation.definition.comment.end.qsp main_comment_end.qsp
          pop: true
        - include: quote_apostroph_comments
        - include: brace_comments
        - include: special_comments

  # Комментарий после 'end': весь текст до '&' или конца строки; внутри
  # {…} закрывающая '}' завершает и комментарий, и внешний блок (её ловит
  # figure_brace). Отдельной plain-версии (comment_after_end) БОЛЬШЕ НЕТ:
  # после Решения-1A (конец п.2.1) все правила 'end' ведут только этот
  # brace-aware контекст — модель «} структурна всегда» едина для top-level
  # и braced-форм. Не переносить порядок правил в comment_tail_common:
  # здесь «&»-pop стоит ПОСЛЕ include'ов и это значимо (pop срабатывает уже
  # внутри quote/brace-состояний).
  comment_after_end_in_brace:
    - meta_content_scope: comment.line.qsp markup.italic.qsp
    - include: quote_apostroph_comments
    - include: brace_comments
    - match: (?=&|\}|{{nr}}|$)
      pop: true

  brace_comments: # данная конструкция отвечает за поддержку вложенных скобок в комменте
    - match: '\{'
      scope: punctuation.definition.comment.begin.qsp brace_comment_start.qsp
      push:
        - meta_scope: comment.qsp
        - match: '\}'
          scope: punctuation.definition.comment.end.qsp brace_comment_end.qsp
          pop: true
        - include: brace_comments
        - include: quote_apostroph_comments
        # - include: apinbrack

  quote_apostroph_comments:
    - match: '{{quote}}' # [^\{\'\"]*?\" open quotes comment
      scope: comment.qsp
      push:
        - meta_scope: comment.qsp
        - match: '{{quote}}'
          scope: comment.qsp
          pop: true
    - match: '{{ap}}' # [^\{\'\"]*?\' open apostrophes comment
      scope: comment.qsp
      push:
        - meta_scope: comment.qsp
        - match: '{{ap}}'
          scope: comment.qsp
          pop: true

  special_comments:
    - match: (?<=\!)@.*?(?={{nr}})
      scope: comment.qsp markup.italic.qsp avs_speccomments

  preprocessor:
    - match: ^(\!@pp\:.*?)$
      captures:
        1: meta.preprocessor.qsp diff.deleted.qsp avs_preprocessor
        #2: markup.bold preprocessor.avs

  qspdocs:
    - match: (?:^\!@\s)([#$%](\d+|r) ... [#$%](\d+|r))(\s+\-\s+)(.*$)
      scope: meta.diff meta.gametext.qsp
      captures:
        1: entity.other.attribute-name.documentation.qsp
    - match: (?:^\!@\s)([#$%](\d+|r))(\s+\-\s+)(.*$)
      scope: meta.diff meta.gametext.qsp
      captures:
        1: entity.other.attribute-name.documentation.qsp

  # # # ---------- фигурные скобки --------------- # # #
  figure_brace:
    - match: '\{'
      scope: punctuation.section.block.begin.qsp avs_brace_begin
      push:
        - meta_content_scope: meta.block
        - include: htmlsupport
        - include: continuation_tail
        # Внутри открытого {…} тело uses brace-aware версию: «}» на
        # строке-комментарии (и после end) закрывает блок, а не ошибка.
        - include: location_body_braced
        - match: '\}'
          scope: punctuation.section.block.end.qsp avs_brace_end
          pop: true

  # # # ------- круглые и квадратные скобки (многострочный код) ------- # # #
  # push происходит только если после открывающей скобки на ЭТОЙ ЖЕ строке
  # нет закрывающей (строковые литералы в кавычках/апострофах «пропускаются»
  # и их скобки не считаются). Сбалансированные в одной строке скобки
  # обрабатываются прежними построчными правилами — поведение
  # одиночных проверок операторов не меняется.
  # NB: внутри regex не используем \xNN — Oniguruma в UTF-8 падает на них
  # («too short multibyte code string»); кавычки/апострофы — через {{ap}}/{{quote}}.
  brackets_multiline:
    - match: '\((?=(?:[^{{ap}}{{quote}})\n]|{{ap}}[^{{ap}}\n]*{{ap}}|{{quote}}[^{{ap}}\n]*{{quote}})*{{nr_lookahead}})'
      scope: punctuation.section.parens.begin.qsp avs_paren_begin
      push: multiline_round
    - match: '\[(?=(?:[^{{ap}}{{quote}}\]\n]|{{ap}}[^{{ap}}\n]*{{ap}}|{{quote}}[^{{ap}}\n]*{{quote}})*{{nr_lookahead}})'
      scope: punctuation.section.brackets.begin.qsp avs_bracket_begin
      push: multiline_square

  multiline_round:
    - meta_content_scope: meta.group.parens.multiline.qsp
    - match: '\)'
      scope: punctuation.section.parens.end.qsp avs_paren_end
      pop: true
    # продолжение выражения на новой строке: съедаем отступ перед
    # оператором/запятой/амперсандом, чтобы правила вида (^\s*?|\&\s*?|\K…)
    # «без левого операнда» не срабатывали ложно на перенесённой строке
    - match: ^\s+(?=[+\-*\/<>=,&])
      scope: meta.continuation.expression.qsp
    - include: continuation_tail
    - include: brackets_multiline
    - include: location_body

  multiline_square:
    - meta_content_scope: meta.group.brackets.multiline.qsp
    - match: '\]'
      scope: punctuation.section.brackets.end.qsp avs_bracket_end
      pop: true
    - match: ^\s+(?=[+\-*\/<>=,&])
      scope: meta.continuation.expression.qsp
    - include: continuation_tail
    - include: brackets_multiline
    - include: location_body

  # Оператор/запятая в КОНЦЕ строки внутри многострочных скобок: выражение
  # продолжается на следующей строке. Sublime матчит правила только в
  # границах текущей строки, поэтому negative lookahead проверок
  # «нет правого операнда» не видит операнд со следующей
  # строки и ложно считает ошибкой.
  # Эти правила перехватывают такие случаи раньше operacion — но только
  # когда до конца строки после оператора ничего, кроме пробелов.
  continuation_tail:
    - match: (?<={{left_operand}})\s*?({{operacion_two_signs}})(?=\s*{{nr_lookahead}})
      scope: keyword.operator.two-signs.qsp
    - match: (?<={{left_operand}})\s*?({{operacion_one_sign}})(?=\s*{{nr_lookahead}})
      scope: keyword.operator.one-sign.qsp
    - match: (?<={{left_operand}})\s*?(,)(?=\s*{{nr_lookahead}})
      scope: punctuation.separator.comma.qsp
    - match: (?<={{left_operand}})\s*\b({{operacion_word}})\b(?=\s*{{nr_lookahead}})
      scope: keyword.operator.word.qsp

  htmlsupport: # Very Big Thanks to deathaxe
    - match: (?i)(<)(qhtml)(>)
      scope: meta.tag.html.qsp
      captures:
        1: punctuation.definition.tag.begin.html.qsp
        2: entity.name.tag.html.qsp
        3: punctuation.definition.tag.end.html.qsp
      push:
        - clear_scopes: true
        - meta_scope: markup.raw text.html.embedded.qsp
        - match: (?i)(</)(qhtml)(>)
          scope: meta.tag.html.qsp
          captures:
            1: punctuation.definition.tag.begin.html.qsp
            2: entity.name.tag.html.qsp
            3: punctuation.definition.tag.end.html.qsp
          pop: true
        - include: Packages/HTML/HTML (Plain).sublime-syntax

  separator_continuation:
    - match: \s_(?=$)
      scope: punctuation.separator.continuation avs_longstring
