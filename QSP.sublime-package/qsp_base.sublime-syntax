  # п.5 аудита: якорь `^` ЗДЕСЬ ОБЯЗАТЕЛЕН и его НЕЛЬЗЯ снимать — плеер (QSP-движок)
  # находит метки ТОЛЬКО в начале строки, поэтому `:` в середине выражения — не метка.
  # БЫЛО `^(\s*\:|\:)`: запись читалась как «вторая альтернатива без якоря» и попала
  # в аудит как дефект — но `^` стоит ПЕРЕД ГРУППОЙ, значит обе ветки привязаны к началу
  # строки, а ветка `\:` полностью избыточна (`\s*` может быть пустым). Проверено
  # зондом: старое и новое правило дают одинаковый результат на `if 1: x`, `& :lab`,
  # `msg a: b` (метки нет); ветка удалена, чтобы такая же ложная тревога не всплыла
  # снова. Регрессов на корпусе нет: все 607 меток в колонке 0 `_examples/**/*.qsps`
  # ловятся одинаково (старое и новое — 607).
  #
  # НЕ реализовано НАМЕРЕННО:
  #   * метка после `&` (`&delimiterChar` в grammar) — grammar и другие редакторы
  #     это разрешают, но плеер распознаёт только метку в начале строки → следуем
  #     плееру, а не grammar;
  #   * кавычки внутри метки (`noteString` их разрешает: `:"текст"`) — на кавычках
  #     плеер ломает распознавание метки, т.е. в метке они НЕВАЛИДНЫ; поэтому класс
  #     `[^&'"\n]+` оставлен как есть (такая строка просто не считается меткой).
  labels:
    - match: ^(\s*):([^&'"\n]+)
      captures:
        2: entity.name.qlabel.qsp avs_jumps_labels

  # # # ------------------- строки ------------------------ # # #
  # п.2.2: общий body (preprocessor+subexpression+htmlsupport) вынесен в
  # string_common; различие двух arms — только символ кавычки и правило
  # удвоения (`""`/`''`).
  # п.3 аудита: meta_scope КАЖДОГО arm'а — по СВОЕЙ кавычке (`double` для `"…"`,
  # `single` для `'…'`). БЫЛО `string.quoted.double.qsp` в ОБОИХ: тема не могла
  # различить тип строки, а meta_scope врал про фактический разделитель.
  # NB: `jump_to_label`/`location_call` по-прежнему красят ОБЕ кавычки
  # `string.quoted.double.qsp` — там строка-аргумент ловится ОДНОЙ группой
  # (`({{ap}}|{{quote}}).*?\3`), разделить scope по символу кавычки нечем.
  strings:
    - match: '"'
      push:
        - meta_scope: string.quoted.double.qsp
        - match: '""'
          scope: constant.character.escape.qsp
        - match: '"'
          pop: true
        - include: string_common
    - match: "'"
      push:
        - meta_scope: string.quoted.single.qsp
        - match: "''"
          scope: constant.character.escape.qsp
        - match: "'"
          pop: true
        - include: string_common

  string_common:
    - include: preprocessor
    - include: subexpression
    - include: htmlsupport

  subexpression:
    - match: '<<'
      scope: punctuation.section.interpolation.begin.qsp avs_begin_subexpression
      push:
        - clear_scopes: true
        - meta_scope: meta.interpolation.qsp
        - meta_content_scope: source.qsp.embedded
        - match: '>>'
          scope: punctuation.section.interpolation.end.qsp avs_end_subexpression
          pop: true
        - include: subex

  subex:
    - include: figure_brace
    - include: sugarfunc
    # Многострочность подвыражения `<< … >>` (grammar `stringSubexpression` =
    # `"<<" mws multilineExpression mws ">>"`, `mws` допускает перенос) разрешена
    # ТОЛЬКО внутри скобок и вложенных строк. `brackets_multiline` пушит
    # `multiline_round`/`multiline_square`, которые поглощают переносы внутри `(`/`[
    # `; `{…}` покрыт `figure_brace`, вложенные строки — `strings`. Правило ниже
    # ловит ГОЛЫЙ перенос (вне скобок/строк) — он остаётся ошибкой.
    - include: brackets_multiline
    - match: (\n\r|\r|\r\n|\n)
      scope: invalid.illegal.qsp avs_wrongenter
    - include: operacion_subex
    - include: system_variables
    - include: functions
    - include: numeric
    - include: strings
    - include: users_variables
    # Пунктуация ОДНОстрочных ( ) [ ] (п.1 аудита): раньше в подвыражении `<< … >>`
    # скобки были вообще без scope — `brackets_inline` подключался только в
    # `body_common_tail`. Включение ПОСЛЕДНИМ — как там: anchor-правила, которые
    # начинают матч с `(`/`[`, должны пробоваться раньше. NB: `\K`-правило
    # `(& x)` из `operacion_ampersand_common` в pushed-контексте НЕ срабатывает
    # (п.31 аудита), поэтому порядок здесь — страховка, а не наблюдаемая разница.
    - include: brackets_inline

  operacion_subex:
    # Операции ВНУТРИ подвыражения `<< … >>` (embedded source). Общие с
    # `operacion` сегменты вынесены в operacion_word_two_signs_common /
    # operacion_ampersand_common (Решение-4/4B) + operacion_no_common (P1.5).
    # Локально оставлены только реально отличающиеся группы: one_sign (нет
    # unary `-`; with_out_right несёт доп. exclusion `(>…)`; with_out_left —
    # lookbehind `(?<=(<|&|(|{|[))` вместо `(^|…)\K`, т.к. здесь нет `^` строки
    # кода) и comma with_out_left (тот же lookbehind).
    - include: operacion_word_two_signs_common
    # подсветка однознаковых операторов
    - match: (?<={{left_operand}})\s*{{operacion_one_sign}}(?!(>|\s*{{right_operand}}))
      scope: invalid.illegal.qsp avs_wrong_one_sign_with_out_right
    - match: '{{left_ctx_lookbehind}}\s*{{operacion_one_sign}}(?=\s*?{{right_operand}}*)'
      scope: invalid.illegal.qsp avs_wrong_one_sign_with_out_left
    - match: '{{operacion_one_sign}}'
      scope: keyword.operator.one-sign.qsp
    # Правила для запятых
    - include: operacion_comma_with_out_right
    - match: '{{left_ctx_lookbehind}}\s*(,)(?=\s*?{{right_operand}}*)'
      scope: invalid.illegal.qsp avs_wrong_comma_with_out_left
    - include: operacion_comma_sign
    - include: operacion_ampersand_common
    - include: operacion_no_common

  # # # ------------------------ Подсветка комментариев ------------------------  # # #
  # Общий хвост комментария (Фаза 3, п.3.1): тело от «!» до конца строки.
  # Используется контекстами comments и comments_in_brace (их arms различаются
  # только якорем и наличием «?\}»-попа, вынесенного в сами arms).
  # ПОРЯДОК правил внутри push-тел значим (поиск слева направо, первое
  # совпадение) — менять только вместе с анализом позиционных коллизий.
  comment_tail_common:
    - match: (\n\r|\r|\r\n|\n|$)
      scope: comment.qsp
      pop: true
    - include: quote_apostroph_comments
    - include: brace_comments
    # Спец-комментарий `!@` подключается САЙТОМ, а не здесь: его завершители
    # обязаны совпадать с завершителями тела-хозяина, а они у plain- и
    # braced-версий разные (см. блок special_comments_*).

  # Комментарий «!» — однострочный или многострочный (через &-продолжения).
  # (п.3.1) Arms НЕ слиты в один regex: ветка «^\s*» матчит только на начале
  # строки, а «\&» — в любой позиции; общая альтернация с внешним \s*
  # ложно расширяла бы набор позиций. Зато тело вынесено в comment_tail_common.
  comments:
    - match: (?<=\{)((\s*)|(\&)\s*)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - include: comment_tail_common
        - include: special_comments_line
    - match: ((^\s*)|(\&)\s*)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - include: comment_tail_common
        - include: special_comments_line

  # Комментарии внутри открытого {…} блока.
  # Отличие от comments: комментарий схлопывается НУЛЕВЫМ lookahead «(?=\})»,
  # не поглощая «}»: если на строке-комментарии стоит «}» нулевого уровня
  # вложенности (нет незакрытой вложенной «{» из brace_comments), то это
  # закрывающая скобка самого блока — её ловит правило закрытия figure_brace.
  # Внутри строковых литералов (quote_apostroph_comments) и вложенных {…}
  # (brace_comments) «}» остаётся защищённой и блок не закрывает.
  comments_in_brace:
    - match: (?<=\{)((\s*)|(\&)\s*)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - match: (?=\})
          pop: true
        - include: comment_tail_common
        - include: special_comments_braced
    - match: ((^\s*)|(\&)\s*)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.qsp
      push:
        - meta_scope: comment.qsp
        - match: (?=\})
          pop: true
        - include: comment_tail_common
        - include: special_comments_braced

  comment_after_colon: # комментарии после двоеточия
    - match: (?<=:)((\s*)|(\&)\s*)(!)
      captures:
        3: support.function.builtin.qsp
        4: punctuation.definition.comment.begin.qsp main_comment_start.qsp
      push:
        - meta_scope: comment.qsp
        - match: (\n\r|\r|\r\n|\n|$)
          scope: punctuation.definition.comment.end.qsp main_comment_end.qsp
          pop: true
        - include: quote_apostroph_comments
        - include: brace_comments
        - include: special_comments_line

  # Хвост-комментарий в заголовке многострочного else (`else !коммент`): ':' по
  # grammar (elseMultiLine `(":" ws)? commentStatement?`) факультативен, поэтому
  # comment_after_colon с lookbehind `(?<=:)` этот случай не ловит, а `comments`
  # видит `!` только в начале строки или после `&` → значок уезжал в оператор NOT.
  # Открывающий `!` потребляет arm multiline_actions_else (capture → punct), здесь
  # живёт ТОЛЬКО тело: до newline, с "…"/'…'/{…} и '@'-спецами — та же механика,
  # что после ':' (потребление хвоста в match убило бы её).
  # meta_content_scope (НЕ meta_scope): scope комментария не должен накрывать сам
  # `else` — он относится к match'у, запушившему этот контекст.
  comment_after_else:
    - meta_content_scope: comment.qsp
    - match: '({{nr}}|$)'
      scope: punctuation.definition.comment.end.qsp main_comment_end.qsp
      pop: true
    - include: quote_apostroph_comments
    - include: brace_comments
    - include: special_comments_line

  # Комментарий после 'end': весь текст до '&' или конца строки; внутри
  # {…} закрывающая '}' завершает и комментарий, и внешний блок (её ловит
  # figure_brace). Отдельной plain-версии (comment_after_end) БОЛЬШЕ НЕТ:
  # после Решения-1A (конец п.2.1) все правила 'end' ведут только этот
  # brace-aware контекст — модель «} структурна всегда» едина для top-level
  # и braced-форм. Не переносить порядок правил в comment_tail_common:
  # здесь «&»-pop стоит ПОСЛЕ include'ов и это значимо (pop срабатывает уже
  # внутри quote/brace-состояний).
  comment_after_end_in_brace:
    - meta_content_scope: comment.line.qsp markup.italic.qsp
    - include: quote_apostroph_comments
    - include: brace_comments
    # как в comment_after_colon: '@'-спецы после `end !` — тот же токен
    # avs_speccomments, но вариант end (pop ещё и по `&`: хвост после `end` —
    # noteString, и разделитель statement'ов его заканчивает)
    - include: special_comments_end
    - match: (?=&|\}|{{nr}}|$)
      pop: true

  # --- Состояния «внутри» комментария: "…", '…', {…} ---
  # Вынесены в ИМЕНОВАННЫЕ контексты (были inline в push-стеках): ОДНО описание
  # структуры используют и обычные комментарии (comment_tail_common,
  # comment_after_colon/else/end), и мёртвый регион однострочных
  # else/elseif (dead_code_comment).
  # Все три ЖИВУТ ЧЕРЕЗ ПЕРЕНОСЫ СТРОК: литерал QSP бывает многострочным
  # (см. corpus: $args['…'] = ' ⏎ … ⏎ '), {…} — блочная структура комментария.
  # Совпадений на «прочий текст» у них НЕТ и не нужно: пока такое состояние на
  # вершине стека, контексты ниже не рассматриваются, и текст просто остаётся
  # под их meta_scope. Именно поэтому `}` внутри "…" не закрывает {…}-блок, а
  # `&`/`end` внутри незакрытого литерала не рвут ни комментарий, ни мёртвый
  # регион.
  comment_in_quote:
    - meta_scope: comment.qsp
    - match: '{{quote}}'
      scope: comment.qsp
      pop: true

  comment_in_apostroph:
    - meta_scope: comment.qsp
    - match: '{{ap}}'
      scope: comment.qsp
      pop: true

  comment_in_brace:
    - meta_scope: comment.qsp
    - match: '\}'
      scope: punctuation.definition.comment.end.qsp brace_comment_end.qsp
      pop: true
    - match: '\{'
      scope: punctuation.definition.comment.begin.qsp brace_comment_start.qsp
      push: comment_in_brace
    - match: '{{quote}}'
      push: comment_in_quote
    - match: '{{ap}}'
      push: comment_in_apostroph

  # вложенные {…} в комментарии (вход в comment_in_brace)
  brace_comments:
    - match: '\{'
      scope: punctuation.definition.comment.begin.qsp brace_comment_start.qsp
      push: comment_in_brace

  # "…" / '…' в комментарии (вход в состояния литералов)
  quote_apostroph_comments:
    - match: '{{quote}}'
      scope: comment.qsp
      push: comment_in_quote
    - match: '{{ap}}'
      scope: comment.qsp
      push: comment_in_apostroph

  # --- Спецкомментарий `!@` ----------------------------------------------
  # `!@` — ВАРИАНТ обычного комментария, а НЕ отдельная конструкция: те же точки
  # входа, те же завершители и та же внутренняя структура ("…"/'…'/{…}); отличается
  # ТОЛЬКО окраской тела — markup.italic + avs_speccomments. Внутренние
  # состояния не дублируются: тело подключает существующую машинерию
  # комментария (quote_apostroph_comments / brace_comments).
  #
  # Маркер ловится В ТЕЛЕ (lookbehind `!`), а не отдельной головой: `!` на всех
  # сайтах уже съеден головой комментария (comments / comments_in_brace /
  # comment_after_colon / arm `else !коммент`), а после `end` и в мёртвом регионе
  # головы нет вовсе. `@` получает тот же begin-пунктуационный scope, что и `!`,
  # поэтому тема, красящая `punctuation.definition.comment`, видит `!@` единым
  # маркером (а avs_speccomments — ещё и как спец-маркер).
  #
  # Тел ТРИ — по набору завершителей САЙТА (push-тело перекрывает внешнее,
  # поэтому завершители обязаны ПОВТОРЯТЬ завершители тела-хозяина):
  #   special_comment_body_line   — newline/$: comments / comment_after_colon /
  #                                 comment_after_else / dead_code_comment
  #                                 (регион продолжается со следующей строки);
  #   special_comment_body_braced — + `(?=\})`: только comments_in_brace (`}` на
  #                                 строке-комментарии закрывает {…}-блок,
  #                                 а не остаётся текстом комментария);
  #   special_comment_body_end    — + `&`/`}`: только comment_after_end_in_brace
  #                                 (после `end` хвост — noteString, и `&`
  #                                 заканчивает его по грамматике).
  special_comments_line:
    - match: '(?<=\!)@'
      scope: punctuation.definition.comment.begin.qsp avs_speccomments
      push: special_comment_body_line

  special_comments_braced:
    - match: '(?<=\!)@'
      scope: punctuation.definition.comment.begin.qsp avs_speccomments
      push: special_comment_body_braced

  special_comments_end:
    - match: '(?<=\!)@'
      scope: punctuation.definition.comment.begin.qsp avs_speccomments
      push: special_comment_body_end

  special_comment_body_line:
    - meta_scope: comment.qsp markup.italic.qsp avs_speccomments
    # POP НУЛЕВОЙ ШИРИНЫ (`?=`): newline НЕ съедаем — иначе тело-хозяин
    # (comment_after_colon / comment_after_else) своего newline-pop'а уже
    # не увидит и проглотит следующую строку.
    - match: (?={{nr}}|$)
      pop: true
    - include: quote_apostroph_comments
    - include: brace_comments

  special_comment_body_braced:
    - meta_scope: comment.qsp markup.italic.qsp avs_speccomments
    - match: (?=\})
      pop: true
    # как в line-варианте: newline не съедаем (pop нулевой ширины)
    - match: (?={{nr}}|$)
      pop: true
    - include: quote_apostroph_comments
    - include: brace_comments

  special_comment_body_end:
    - meta_scope: comment.qsp markup.italic.qsp avs_speccomments
    - include: quote_apostroph_comments
    - include: brace_comments
    - match: (?=&|\}|{{nr}}|$)
      pop: true

  preprocessor:
    # lazy `.*?` перед `$` избыточен (движок всё равно обязан дойти до конца строки) — P4.3.
    - match: ^(\!@pp\:.*)$
      captures:
        1: meta.preprocessor.qsp diff.deleted.qsp avs_preprocessor
        #2: markup.bold preprocessor.avs

  # Документация локации (`!@`): в qsp_grammar.peg такого синтаксиса нет — это
  # соглашение корпуса, поэтому правила ниже только оформительские.
  # P4.1 (2026-10-29): `...` — ЛИТЕРАЛЬНОЕ многоточие, а не «три любых символа»
  # (прежняя запись ` ... ` требовала РОВНО один пробел с каждой стороны и матчила
  # `!@ #1 XXX #2 - …`, но НЕ матчила `!@ #1 ... #2 - …`).
  # Вокруг — горизонтальные `[ \t]*` (в т.ч. ноль): `\s*` нельзя, `\s` включает
  # перенос, и заголовок склеил бы соседние строки.
  qspdocs:
    - match: (?:^\!@\s)([#$%](\d+|r)[ \t]*\.\.\.[ \t]*[#$%](\d+|r))(\s+\-\s+)(.*$)
      scope: meta.diff meta.gametext.qsp
      captures:
        1: entity.other.attribute-name.documentation.qsp
    - match: (?:^\!@\s)([#$%](\d+|r))(\s+\-\s+)(.*$)
      scope: meta.diff meta.gametext.qsp
      captures:
        1: entity.other.attribute-name.documentation.qsp

  # # # ---------- фигурные скобки --------------- # # #
  figure_brace:
    - match: '\{'
      scope: punctuation.section.block.begin.qsp avs_brace_begin
      push:
        - meta_content_scope: meta.block.qsp
        # Фаза 9: `--` внутри незакрытой `{` — ошибка (зеркало wrongclose для
        # незакрытого блока: красим конец локации и закрываем один уровень)
        - include: wrongclose_locend
        - include: htmlsupport
        - include: continuation_tail
        # Внутри открытого {…} тело uses brace-aware версию: «}» на
        # строке-комментарии (и после end) закрывает блок, а не ошибка.
        - include: location_body_braced
        - match: '\}'
          scope: punctuation.section.block.end.qsp avs_brace_end
          pop: true

  # # # ------- круглые и квадратные скобки (многострочный код) ------- # # #
  # push происходит только если после открывающей скобки на ЭТОЙ ЖЕ строке
  # нет закрывающей (строковые литералы в кавычках/апострофах «пропускаются»
  # и их скобки не считаются). Сбалансированные в одной строке скобки
  # обрабатываются прежними построчными правилами — поведение
  # одиночных проверок операторов не меняется.
  # NB: внутри regex не используем \xNN — Oniguruma в UTF-8 падает на них
  # («too short multibyte code string»); кавычки/апострофы — через {{ap}}/{{quote}}.
  # NB: «пропускаемая строка» в lookahead'е исключает СВОЙ разделитель
  # (`{{quote}}[^{{quote}}\n]*{{quote}}` для кавычек, `{{ap}}[^{{ap}}\n]*{{ap}}` для
  # апострофов). Копипаст с чужим классом в кавычковой альтернативе ломал
  # распознавание `"…'…"` → незакрытая `(`/`[` на такой строке не виделась
  # и многострочность терялась: `$x = ("Bob's" +` ⏎ `"dog")` (п.4 аудита).
  brackets_multiline:
    - match: '\((?=(?:[^{{ap}}{{quote}})\n]|{{ap}}[^{{ap}}\n]*{{ap}}|{{quote}}[^{{quote}}\n]*{{quote}})*{{nr_lookahead}})'
      scope: punctuation.section.parens.begin.qsp avs_paren_begin
      push: multiline_round
    - match: '\[(?=(?:[^{{ap}}{{quote}}\]\n]|{{ap}}[^{{ap}}\n]*{{ap}}|{{quote}}[^{{quote}}\n]*{{quote}})*{{nr_lookahead}})'
      scope: punctuation.section.brackets.begin.qsp avs_bracket_begin
      push: multiline_square

  multiline_round:
    - meta_content_scope: meta.group.parens.multiline.qsp
    - match: '\)'
      scope: punctuation.section.parens.end.qsp avs_paren_end
      pop: true
    # Фаза 9: `--` внутри незакрытой `(` — ошибка (до правила-продолжения)
    - include: wrongclose_locend
    # продолжение выражения на новой строке: съедаем отступ перед
    # оператором/запятой/амперсандом, чтобы правила вида (^\s*?|\&\s*?|\K…)
    # «без левого операнда» не срабатывали ложно на перенесённой строке
    - match: ^\s+(?=[+\-*\/<>=,&])
      scope: meta.continuation.expression.qsp
    - include: continuation_tail
    - include: brackets_multiline
    - include: location_body

  multiline_square:
    - meta_content_scope: meta.group.brackets.multiline.qsp
    - match: '\]'
      scope: punctuation.section.brackets.end.qsp avs_bracket_end
      pop: true
    # Фаза 9: `--` внутри незакрытой `[` — ошибка (до правила-продолжения)
    - include: wrongclose_locend
    - match: ^\s+(?=[+\-*\/<>=,&])
      scope: meta.continuation.expression.qsp
    - include: continuation_tail
    - include: brackets_multiline
    - include: location_body

  # # # ------- круглые и квадратные скобки (ОДНОстрочный код) ------- # # #
  # Фаза 10: сбалансированные в одной строке скобки раньше не получали НИКАКОГО
  # scope — пунктуацию ставили только brackets_multiline и multiline_round/square,
  # а они срабатывают только на НЕзакрытой скобке. Отсюда асимметрия:
  # `if (1 +` / `2) = 3:` красились как punctuation, а `if ($a and $b):` — нет
  # (найдено прогоном автотестов, HANDOFF §1p).
  # Здесь ТОЛЬКО пунктуация: без push и без meta-группы, состояние стека не меняется,
  # «многострочность» по-прежнему определяет единственный brackets_multiline
  # (он стоит раньше — body_common_head).
  brackets_inline:
    - match: '\('
      scope: punctuation.section.parens.begin.qsp avs_paren_begin
    - match: '\)'
      scope: punctuation.section.parens.end.qsp avs_paren_end
    - match: '\['
      scope: punctuation.section.brackets.begin.qsp avs_bracket_begin
    - match: '\]'
      scope: punctuation.section.brackets.end.qsp avs_bracket_end

  # Оператор/запятая в КОНЦЕ строки внутри многострочных скобок: выражение
  # продолжается на следующей строке. Sublime матчит правила только в
  # границах текущей строки, поэтому negative lookahead проверок
  # «нет правого операнда» не видит операнд со следующей
  # строки и ложно считает ошибкой.
  # Эти правила перехватывают такие случаи раньше operacion — но только
  # когда до конца строки после оператора ничего, кроме пробелов.
  continuation_tail:
    - match: (?<={{left_operand}})\s*({{operacion_two_signs}})(?=\s*{{nr_lookahead}})
      scope: keyword.operator.two-signs.qsp
    - match: (?<={{left_operand}})\s*({{operacion_one_sign}})(?=\s*{{nr_lookahead}})
      scope: keyword.operator.one-sign.qsp
    - match: (?<={{left_operand}})\s*(,)(?=\s*{{nr_lookahead}})
      scope: punctuation.separator.comma.qsp
    - match: (?<={{left_operand}})\s*\b({{operacion_word}})\b(?=\s*{{nr_lookahead}})
      scope: keyword.operator.word.qsp

  htmlsupport: # Very Big Thanks to deathaxe
    - match: (?i)(<)(qhtml)(>)
      scope: meta.tag.html.qsp
      captures:
        1: punctuation.definition.tag.begin.html.qsp
        2: entity.name.tag.html.qsp
        3: punctuation.definition.tag.end.html.qsp
      push:
        - clear_scopes: true
        - meta_scope: markup.raw text.html.embedded.qsp
        - match: (?i)(</)(qhtml)(>)
          scope: meta.tag.html.qsp
          captures:
            1: punctuation.definition.tag.begin.html.qsp
            2: entity.name.tag.html.qsp
            3: punctuation.definition.tag.end.html.qsp
          pop: true
        - include: Packages/HTML/HTML (Plain).sublime-syntax


  separator_continuation:
    - match: '[ ]_(?=$)' # only space and underline characters in line-end. not \t.
      scope: punctuation.separator.continuation.qsp avs_longstring
