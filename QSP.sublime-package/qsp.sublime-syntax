%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html
#
# Quest Soft Player 5.8.0 Language:
# https://qsp.org/
#
# Формат qsps: ВЕСЬ файл как проект (текст2гейм/qsp-txt).
#   - первая строка `QSP-Game`;
#   - локации — блоки `# …` … `--`;
#   - текст между локациями игнорируется (подсветка как комментарий).
# Подсветка кода ТЕЛА локации общая с форматом qsrc — вынесена в базу
# `qsp_base.sublime-syntax` и подключена через `extends`. Здесь живёт только
# специфика qsps: разбор границ локаций, заголовок и между-локационный текст.

name: QSP # название языка
scope: source.qsp
version: 2
extends: qsp_base.sublime-syntax
file_extensions: # расширения файлов (группа qsps)
  - qsps
  - qsp-text
  - text-qsp
first_line_match: ^(?i:qsp-game)(\s+.*)?$

contexts:
  main: # обязательный контекст main, с него стартует распознавание синтаксиса
    # Подсветка заголовка файла, только если он идёт первой строкой.
    - include: qspgame_header
    - match: ''
      set: diff

  diff:
    - include: preprocessor
    - include: qspdocs
    - include: location_def
    - match: '.*' # любое множество символов между локациями подсвечивается как комментарий
      scope: meta.diff meta.gametext.qsp # TODO: заменить meta.diff на comment.block, когда сделаю сниппеты в плагинах

  location_def:
    - match: ^(\s*?)(#)\s?(.+)$
      captures:
        2: keyword.declaration.location.qsp
        3: entity.name.location.qsp meta.start_location.qsp
      push:
        - meta_scope: meta.location.qsp
        # Fidelity к qsp_grammar.peg (п.6.6): endOfLoc = `"--" … newline` — `--` стоит
        # В НАЧАЛЕ СТРОКИ и НЕ привязан к отступу строки `#`. Прежняя обратная ссылка
        # `^\1(--)` ложно требовала совпадения отступов — убрана (capture-номера 1/2 сохранены).
        - match: ^(--)(.*?)$
          pop: true
          captures:
            1: punctuation.definition.keyword markup.bold.qsp keyword.control meta.end_location.qsp
            2: markup.heading # TODO: насколько верно такое определение от заголовков разделов, так как по сути это комментарий
        - include: location_body
        # Одиночная `}` ВНЕ открытого `{` — ошибка (зеркало wrong_close_in_brace для
        # верхнего уровня). Внутри `{…}` закрывающая `}` штатно закрывает блок (её
        # ловит push figure_brace), поэтому правило живёт на уровне ЛОКАЦИИ, а не в
        # location_body: в location_body оно попало бы в braced-двойник и перебило бы
        # закрытие блока.
        - match: '\}'
          scope: invalid.illegal.qsp avs_wrong_closed_brace

  qspgame_header:
    - match: (?<![\s\S])(?i:(qsp-game))(\s+.*)?$
      captures:
        1: markup.heading.1.qsp punctuation.definition.heading.begin.qsp
        2: markup.heading.1.qsp
