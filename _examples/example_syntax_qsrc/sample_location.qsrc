!@ QSP-Game Пример формата .qsrc: ВЕСЬ файл — ОДНА локация.
! Начало локации = начало файла, конец = конец файла.
! Здесь нет «текста между локациями» и нет блоков `# … --`.

! ---------- переменные и системные величины ----------
$Игрок = 'Алекс'
set x = 5 + y
local $временная
%Счёт = [1, 2, 3]
nosave = 1
debug = 0
$bcolor = rgb(255, 0, 0)
counter = 'пройдено ходов: '
$args = 0
%dims = arrpack('a,b,c')

! ---------- многострочные скобки ( ) и [ ] ----------
b = @sum([1,
	2,
	3])
%A = [
	'элемент1',
	'элемент2'
]
set c = (1 +
	2) * 3

! ---------- операторы ----------
cls
msg 'Привет, <<$Игрок>>!'
addobj 'монета|1|иконка'
showobjs 1
showstat 1
showacts 1
dynamic '$curloc'
jump 'hhhhh'
goto 'другая_локация'
gt 'локация2'
gosub 'подпрограмма'
gs 'подпрограмма2'
view 'img/pic.jpg'
settimer 500
refint

! ---------- неявные вызовы (sugar): @функция, @@gosub ----------
$текст = @Функция(1)
@@Процедура(2)
$x = ("Bob's" + 
	"dog")

! ---------- строки и подвыражения << … >> ----------
$p1 = 'обычная "строка" со <<1 + 2>> внутри'
$p2 = 'кавычки ''внутри'' и <<$x * 2>>'
$p3 = 'удвоенные ""кавычки как экранирование""'

! ---------- инлайн-блок { … } ----------
msg '{привет <<$x>> мир}'

! ---------- условие IF / ELSEIF / ELSE ----------
IF $x > 5:
	msg 'больше'
ELSEIF $x = 5:
	msg 'равно'
ELSE:
	msg 'меньше'
END IF

! ---------- цикл LOOP … WHILE … STEP ----------
LOOP $i = 1 WHILE $i <= 3 STEP 1:
	msg 'итерация <<$i>>'
END LOOP

! ---------- многострочное действие ACT … END ----------
ACT 'Взять предмет':
	addobj 'ключ|2|'
	msg 'предмет взят'
END ACT

! ---------- метка (jump target) ----------
:метка1
	msg 'прыгнули на метку'

! ---------- встроенный HTML ----------
{<qhtml><b>жирный</b> и обычный текст</qhtml>}

! ---------- перенос длинной команды через _ в конце строки ----------
SET $x = 1 + _
2

! ---------- комментарии внутри блока ----------
IF $x = 2: ! это комментарий после двоеточия
	msg 'два'
END

! В qsrc строки, похожие на qsps-границы, — отдельные statements (НЕ блок):
# Похоже на заголовок локации — подсвечено как statement начала
-- Похоже на конец локации — подсвечено как statement конца

! … а тело после них продолжает подсвечиваться как код локации:
msg 'работаем дальше'

! ---------- { … }: «}» на строке-комментарии закрывает блок ----------
! (не помечается ошибкой; подсветка не «течёт» на весь файл)
dynamic {*pl a+b
! комментарий перед скобкой}
msg 'после блока — снова вне {…}'

! вложенная {…} внутри комментария защищена; блок закрывает только
! «}» нулевого уровня вложенности
dynamic {*pl a+b
! комментарий {с вложенной
скобкой} перед скобкой}
msg 'снова вне блока'

! «}» может стоять сразу после end (end-комментарий внутри блока)
{
	act 'действие':
		*pl 'тело'
	end текст end-комментария}

! вложенные act/if внутри {…}: «}» закрывает блок после корректного end
{
	if $x=1:
		*pl 'a'
	end
	! финальный комментарий перед закрывающей}

! ---------- спецкомментарий !@: та же структура, другая окраска ----------
!@ доки локации — обычный комментарий с маркером `!@`
!@ {вложенный {блок}} и "кавычки" разбираются как в обычном комментарии
{
	!@ «фигурная» в кавычках блок не закрывает: "}"
}
{!@ хвост спецкомментария закрывает блок}
msg 'после блоков — снова код'
