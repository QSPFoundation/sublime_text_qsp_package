QSP-Game Многострочные заголовки act/if/loop со скобками ( ) [ ]  — фикстура Фазы 7

! Назначение: проверить, ОТКРЫВАЕТСЯ ли многострочная (блочная) форма act/if/loop,
! когда в её заголовке есть скобка ( ) или [ ], раскрытая на несколько строк
! (закрывающая скобка и сам ':' уходят на другую строку).
! Статус 2026-10-26: ФАЗА 7 ЗАВЕРШЕНА, рендер подтверждён — блочные формы с
! многострочной скобкой: else/elseif/end валидны; однострочная форма
! (утверждение после ':' на строке закрытия скобки): else/end — invalid (excess).
! Статус 2026-10-27: ФАЗА 8 — многострочная скобка ДО 'while' в заголовке loop
! (инициализирующая группа `loopMultiLine`); блок открывается только если 'while'
! наступил раньше ':' (см. лок loop__скобка_до_while_без_while).

# baseline__закрытая_скобка_на_одной_строке
! Всё подсвечивается корректно:
if ($a and $b):
    *pl "if baseline ok"
else:
    *pl "else baseline ok"
end

act ("desc", $x > 0):
    *pl "act baseline ok"
end

loop local $i while $i < 5 step $i += 1:
    *pl "<<$i>>"
end
-- baseline__закрытая_скобка_на_одной_строке ------------------------------

# if__многострочная_круглая_скобка
! Многострочный if с многострочным условием
if (1 +
    2) = 3:
    *pl "тело if"
elseif (4 +
    5) = 9:
!^^^^^ elseif валиден (Фаза 7 починена)
    *pl "тело elseif"
else:
!^^^ else валиден (Фаза 7 починена)
    *pl "тело else"
end
!^^ end валиден (Фаза 7 починена)
-- if__многострочная_круглая_скобка ------------------------------

# if__многострочная_квадратная_скобка
! Однострочный if с многострочным условием
if [1,
    2,
    3] = $arr: *pl "массив в условии"
else:
!^^^ else подсвечивается как invalid — ВЕРНО: однострочная форма if (утверждение после ':')
    *pl "else"
end
!^^ end подсвечивается как invalid — ВЕРНО: однострочная форма
-- if__многострочная_квадратная_скобка ------------------------------

# act__многострочная_круглая_скобка
! Однострочная act c многострочным аргументом
act ("взять ключ",
    hp > 0): *pl "тело act"
end
!^^ end подсвечивается как invalid — ВЕРНО: однострочная форма act
-- act__многострочная_круглая_скобка ------------------------------

# loop__многострочная_круглая_скобка
! многострочная скобка внутри while многострочного loop
loop while (i <
    (5 +
    1)) step i += 1:
    *pl "тело loop <<i>>"
end
!^^ end валиден

! многострочность в loop ДО while (Фаза 8): tuple в инициализирующей группе,
! 'while' приходит только после закрытия скобки — заголовок валиден.
loop local i = [1,
    2,
    3 ] while i = [1,
    2,3] step o+=1:
!^^^ loop валиден (Фаза 8 починена: guard «while на строке» снят с bracket-arm)
    *pl 'ffff'
end
!^^ end валиден (блок открыт: 'while' наступил до ':')
-- loop__многострочная_круглая_скобка ------------------------------

# loop__скобка_до_while_без_while
! Многострочная скобка до 'while', но 'while' в заголовке НЕ появляется —
! битый код (grammar loopMultiLine требует whileMarker). Pending обязан НЕ
! открывать блок: ':' наступил раньше 'while'.
loop local i = [1,
    2,
    3 ] step o+=1:
    *pl 'broken loop'
end
!^^ end подсвечивается как invalid — ВЕРНО: блок не открыт (заголовок без while)
-- loop__скобка_до_while_без_while ------------------------------

# braced__loop_скобка_до_while
! Тот же кейс Фазы 8 внутри {…} — зеркало multiline_loop_pending_prewhile_braced.
{
    loop local i = [1,
        2,
        3 ] while i = [1,2,3] step o = rand(1,
            23):
        *pl 'braced loop'
    end
    !^^ end валиден
}
-- braced__loop_скобка_до_while ------------------------------

# вложенные_многострочные_заголовки
!!! ПОМЕТИ: act с многострочной ( ВНУТРИ многострочного if. Оба end не должны быть ошибками.
if (a and
    b):
    act ("дело",
        c >
        d):
        *pl "внутри if, внутри act"
    end
    !^^ end валиден
end
!^^ end валиден
-- вложенные_многострочные_заголовки ------------------------------

# строки_не_должны_открывать_скобку
! Скобки внутри кавычек не ломают подсветку
! и закрывается на строке с ':'.
if ("текст (не скобка" +
    " ещё текст") = $s:
    *pl "проверка строковых скобок"
end
!^^ end валиден
-- строки_не_должны_открывать_скобку ------------------------------

# комментарий_после_двоеточия
!!! ПОМЕТИ: '!' после ':' на строке закрытия заголовка — не должен мешать открытию.
if (a and
    b): ! обычный комментарий после двоеточия
    !^^^^^^^^^^^^^ комментарий после ':' валиден (Фаза 7 починена)
    *pl "тело"
end
!^^ end валиден (Фаза 7 починена)
-- комментарий_после_двоеточия ------------------------------

# braced__многострочная_скобка_в_заголовке_внутри_фигурных
!!! 
{
    if (x and
        y):
        *pl "braced if тело"
    else:
    !^^^ else валиден
        *pl "braced else"
    end
    !^^ end валиден
}
-- braced__многострочная_скобка_в_заголовке_внутри_фигурных ------------------------------