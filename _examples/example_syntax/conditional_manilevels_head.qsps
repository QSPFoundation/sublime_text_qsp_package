QSP-Game Многострочные заголовки act/if/loop со скобками ( ) [ ]  — фикстура Фазы 7

! Назначение: проверить, ОТКРЫВАЕТСЯ ли многострочная (блочная) форма act/if/loop,
! когда в её заголовке есть скобка ( ) или [ ], раскрытая на несколько строк
! (закрывающая скобка и сам ':' уходят на другую строку).
! Контроль ниже помечен '!!! ПОМЕТИ:' — ожидаемое ПОСЛЕ Фазы 7 поведение.
! Статус 2026-10-26: ФАЗА 7 ЗАВЕРШЕНА, рендер подтверждён — блочные формы с
! многострочной скобкой: else/elseif/end валидны; однострочная форма
! (утверждение после ':' на строке закрытия скобки): else/end — invalid (excess).

# baseline__закрытая_скобка_на_одной_строке
! КОНТРОЛЬ (должно работать уже сейчас): скобка закрыта на месте, ':' на этой же строке.

! Всё подсвечивается корректно:
if ($a and $b):
    *pl "if baseline ok"
else:
    *pl "else baseline ok"
end

act ("desc", $x > 0):
    *pl "act baseline ok"
end

loop local $i while $i < 5 step $i += 1:
    *pl "<<$i>>"
end
-- baseline__закрытая_скобка_на_одной_строке ------------------------------

# if__многострочная_(
!!! ПОМЕТИ: открывается ли блок if? Должны: else/elseif/end НЕ как ошибки.
if (1 +
    2) = 3:
    *pl "тело if"
elseif (4 +
    5) = 9:
!^^^^^ elseif валиден (Фаза 7 починена)
    *pl "тело elseif"
else:
!^^^ else валиден (Фаза 7 починена)
    *pl "тело else"
end
!^^ end валиден (Фаза 7 починена)
-- if__многострочная_( ------------------------------

# if__многострочная_[
!!! ПОМЕТИ: многострочный [ ] в условии.
if [1,
    2,
    3] = $arr: *pl "массив в условии"
else:
!^^^ else подсвечивается как invalid — ВЕРНО: однострочная форма if (утверждение после ':')
    *pl "else"
end
!^^ end подсвечивается как invalid — ВЕРНО: однострочная форма
-- if__многострочная_[ ------------------------------

# act__многострочная_(
!!! ПОМЕТИ: многострочная ( в заголовке act; закрытие end не должно быть excess.
act ("взять ключ",
    hp > 0): *pl "тело act"
end
!^^ end подсвечивается как invalid — ВЕРНО: однострочная форма act
-- act__многострочная_( ------------------------------

# loop__многострочная_(
!!! ПОМЕТИ: многострочная ( в while-условии loop (+ вложенная скобка); end не excess.
loop while (i <
    (5 +
    1)) step i += 1:
    *pl "тело loop <<i>>"
end
!^^ end валиден (Фаза 7 починена)
-- loop__многострочная_( ------------------------------

# вложенные_многострочные_заголовки
!!! ПОМЕТИ: act с многострочной ( ВНУТРИ многострочного if. Оба end не должны быть ошибками.
if (a and
    b):
    act ("дело",
        c >
        d):
        *pl "внутри if, внутри act"
    end
    !^^ end валиден (Фаза 7 починена)
end
!^^ end валиден (Фаза 7 починена)
-- вложенные_многострочные_заголовки ------------------------------

# строки_не_должны_открывать_скобку
!!! ПОМЕТИ: '(' и '[' ВНУТРИ кавычек — НЕ открытие скобки; реальная ( после if открыта
! и закрывается на строке с ':'.
if ("текст (не скобка" +
    " ещё текст") = $s:
    *pl "проверка строковых скобок"
end
!^^ end валиден (Фаза 7: '(' внутри кавычек — не открытие)
-- строки_не_должны_открывать_скобку ------------------------------

# комментарий_после_двоеточия
!!! ПОМЕТИ: '!' после ':' на строке закрытия заголовка — не должен мешать открытию.
if (a and
    b): ! обычный комментарий после двоеточия
    !^^^^^^^^^^^^^ комментарий после ':' валиден (Фаза 7 починена)
    *pl "тело"
end
!^^ end валиден (Фаза 7 починена)
-- комментарий_после_двоеточия ------------------------------

# braced__многострочная_скобка_в_заголовке_внутри_фигурных
!!! ПОМЕТИ: то же, но внутри { } (путь *_braced).
{
    if (x and
        y):
        *pl "braced if тело"
    else:
    !^^^ else валиден (Фаза 7 починена, путь *_braced)
        *pl "braced else"
    end
    !^^ end валиден (Фаза 7 починена, путь *_braced)
}
-- braced__многострочная_скобка_в_заголовке_внутри_фигурных ------------------------------