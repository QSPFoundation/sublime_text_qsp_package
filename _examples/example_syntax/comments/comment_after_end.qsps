QSP-Game 

# after_end
! однострочный комментарий за end`ом
if 1:
	!pass
end эта строка текста игнорируется плеером

! комментарий оканчивается со следующей командой
if 1:
	!pass
end комментарий & *pl 'команда'

! многострочный комментарий после end — через вложенные { }
if 1:
	!pass
end комментарий { открывается здесь
	и продолжается на следующей строке } до конца строки

! & внутри {}, кавычек и апострофов НЕ прерывает комментарий.
if 1:
	!pass
end { & } " & " ' & ' комментарий продолжается & *pl 'а это уже команда'

! Многострочный комментарий после end, оканчивающийся командой
if 1:
	!pass
end многострочный "
	комментарий " оканчивающийся & *pl 'рабочей командой'
-- after_end ---------------------------------

