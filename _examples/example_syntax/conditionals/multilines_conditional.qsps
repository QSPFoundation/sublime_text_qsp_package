QSP-Game Условия. Многострочные

# outer_keywords_
end & ! лишний end подсвечивается, как invalid

elseif & ! elseif вне условия, invalid

else if & ! else if вне условия, invalid

else & ! else вне условия, invalid
--- outer_keywords ---------------------------------

# comments_into_condition
! многострочное условие без комментария после двоеточия
if x > y and d > j:
	*pl 'Команды'
end

! многострочное условие с комментарием после двоеточия
if x > y and d > j: ! валидный комментарий
	*pl 'Команды'
end

! многострочное условие с многострочным комментарием после двоеточия
if x > y and d > j: ! валидный "
	многострочный " комментарий
	*pl 'Команды'
end

--- comments_into_condition ---------------------------------

# errors_in_conditions

! Валидная структура многострочного условие с однострочными elseif и else
if 0:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
	else: *pl '0'
!   ^^^^ валидный else с двоеточием
end

if 0:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
	else *pl '0'
!   ^^^^ валидный else без двоеточия
end

! лишний else
if 0:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
	else: *pl '0'
!   ^^^^^ валидный else
	else: *pl '0'
!   ^^^^ невалидный else (дубликат)
end

! кривой else
if 0:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
	else x = 5: *pl '0'
!   ^^^^^^^^^^^^^^^^^^^ вся строка невалидна, поскольку else не допускает условия
end

! кривой elseif
if 0:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
	elseif: *pl '0'
!   ^^^^^^ невалидный elseif без условия
end

! кривой else if
if 0:
	else if x = 1: *pl '1'
!   ^^^^^^^ валидный else if с раздельным написанием
	else if x = 2: *pl '2'
	else if x = 3: *pl '3'
	else if x = 4: *pl '4'
	else if: *pl '5'
! ^^^^^^^^^^^^^^^^^^ вся строка невалидна из-за кривого else if
	else: *pl '0'
end

! многострочные elseif и else
if 0:
	! pass
elseif x = 1:
	*pl '1'
elseif x = 2:
	*pl '2'
elseif x = 3:
	*pl '3'
elseif x = 4:
	*pl '4'
else:
	*pl '0'
end

! многострочные elseif и else с комментариями после двоеточия
if 0:
	! pass
elseif x = 1: ! первый вариант
	*pl '1' & ! этот код будет выполняться, подсвечиваем, как код
elseif x = 2: ! второй вариант
	*pl '2'
elseif x = 3: ! третий вариант
	*pl '3'
elseif x = 4: ! четвёртый вариант
	*pl '4'
else: ! вариант по умолчанию
	*pl '0'
end

! многострочные elseif и else с комментариями после двоеточия
if 0:
	! pass
elseif x = 1: ! первый вариант
	*pl '1' & ! этот код будет выполняться, подсвечиваем, как код
elseif x = 2: ! второй вариант
	*pl '2'
elseif x = 3: ! третий вариант
	*pl '3'
elseif x = 4: ! четвёртый вариант
	*pl '4'
else ! вариант по умолчанию
!    ^ подсвечивается как оператор one-sign, а должен открывать комментарий
	*pl '0'
!   ^^^^^^^ обычный код, потому что сразу после else написан валидный комментарий
end

! однострочные elseif и else, хотя и с комментариями после двоеточия
if 0:
	! pass
elseif x = 1: & ! первый вариант
	*pl '1' & ! этот код НЕ будет выполняться, подсвечиваем, как комментарий
elseif x = 2: & ! второй вариант
	*pl '2'
elseif x = 3: & ! третий вариант
	*pl '3'
elseif x = 4: & ! четвёртый вариант
	*pl '4'
else: & ! вариант по умолчанию
	*pl '0'
!   ^^^^^^^ подсвечивается как комментарий, потому что else однострочный
end

! однострочные elseif и else, хотя и с комментариями после двоеточия
if 0:
	! pass
elseif x = 1: & ! первый вариант
	*pl '1' & ! этот код НЕ будет выполняться, подсвечиваем, как комментарий
elseif x = 2: & ! второй вариант
	*pl '2'
elseif x = 3: & ! третий вариант
	*pl '3'
elseif x = 4: & ! четвёртый вариант
	*pl '4'
else & ! вариант по умолчанию
	*pl '0'
!   ^^^^^^^ подсвечивается как комментарий, потому что else однострочный
end

! однострочные elseif и else, хотя и с комментариями после двоеточия
if 0:
	! pass
elseif x = 1: & ! первый вариант
	*pl '1' & ! этот код НЕ будет выполняться, подсвечиваем, как комментарий
elseif x = 2: & ! второй вариант
	*pl '2'
elseif x = 3: & ! третий вариант
	*pl '3'
elseif x = 4: & ! четвёртый вариант
	*pl '4'
else *pl '5'
	*pl '0'
!   ^^^^^^^ подсвечивается как комментарий, потому что else однострочный
end

! однострочные elseif с игнорируемыми командами в следующих строках
if 0:
	!pass
elseif x = 1: *pl '1'
	gosub '1' & ! команды подсвечиваются, как комментарий
elseif x = 2: *pl '2'
	gosub '2' & ! потому что игнориуются плеером.
elseif x = 3: *pl '3'
	gosub '3' & ! ни одна из команд, следующих после
elseif x = 4: *pl '4'
	gosub '4' & ! однострочной else или elseif,
else: *pl '0'
	gosub '0' & ! не будет исполнена
end

! лишний end в однострочном else
if 1:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
	else: end
!         ^^^ невалидный end находится не на своём месте внутри пункта
end
--- errors_in_conditions ---------------------------------


# ends_in_conditions
! тесты end`ов и вложенных условий

! end if — только `end` подсвечивается как ключевое слово, всё после него — комментарий:
if 1:
	!pass
end if

! комментарий за end`ом
if 1:
	!pass
end эта строка текста игнорируется плеером

! комментарий оканчивается со следующей командой
if 1:
	!pass
end комментарий & *pl 'команда'

! многострочный комментарий после end — через вложенные { }
if 1:
	!pass
end комментарий { открывается здесь
	и продолжается на следующей строке } до конца строки

! & внутри {}, кавычек и апострофов НЕ прерывает комментарий, а вот здесь — прерывает
if 1:
	!pass
end { & } " & " ' & ' комментарий продолжается & *pl 'а это уже команда'

! Многострочный комментарий после end, оканчивающийся командой
if 1:
	!pass
end многострочный "
	комментарий " оканчивающийся & *pl 'рабочей командой'

! вложенные условия
if 1:
	if 2:
		x = 3
	else:
		x = 4
	end
elseif x = 5: y = 9
else:
	if 0:
		new = old
	else: ! комментарий
		"Структура не ломается"
	end
end

! незакрытое условие руинит подсветку внутри фигурных скобок и подсветку конца локации
{
	if 1:
		else if x = 1: x
		else:
			gosub '1'
	! условие не закрыто
}
!^^^^^ вся строка со скобкой подсвечивается Invalid, потому что закрывает блок раньше, чем закрыто условие
gosub '12' & ! остальные комманды подсвечиваются нормально

--- ends_in_conditions ---------------------------------
!^^^^^ вся строка со скобкой подсвечивается Invalid, потому что закрывает локацию раньше, чем закрыто условие