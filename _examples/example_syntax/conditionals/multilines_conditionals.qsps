QSP-Game Условия. Многострочные

# outer_keywords_
end & ! лишний end подсвечивается, как invalid

elseif & ! elseif вне условия, invalid

else if
!^^^ else вне условия invalid, if матчится как keyword.control

else & ! else вне условия, invalid
--- outer_keywords ---------------------------------

# comments_into_condition
! Простые примеры многострочных условий.

! многострочное условие без комментария после двоеточия:
if x > y and d > j:
	*pl 'Команды'
end

! многострочное условие с комментарием после двоеточия:
if x > y and d > j: ! валидный комментарий
	*pl 'Команды'
end

! многострочное условие с многострочным комментарием после двоеточия:
if x > y and d > j: ! валидный "
	многострочный " комментарий
	*pl 'Команды не закомментированы'
end

--- comments_into_condition ---------------------------------

# errors_in_conditions
! Валидная структура многострочного условие с однострочными elseif и else:
if 0:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
!   ^^^^^^ валидный elseif
	else: *pl '0'
!   ^^^^ валидный else с двоеточием
end

! Валидная структура многострочного условия с однострочными else if и else:
if 0:
	else if x = 1: *pl '1'
!   ^^^^^^^ валидный else if с раздельным написанием (эквивалент elseif)
	else if x = 2: *pl '2'
	else if x = 3: *pl '3'
	else if x = 4: *pl '4'
	else *pl '0'
!   ^^^^ валидный else без двоеточия
end

! лишний else
if 0:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
	else: *pl '0'
!   ^^^^^ валидный else
	else: *pl '0'
!   ^^^^ невалидный else (дубликат)
end

! кривой else
if 0:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
	else x = 5: *pl '0'
!   ^^^^^^^^^^^^^^^^^^^ вся строка невалидна, поскольку else не допускает условия
end

! кривой elseif
if 0:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
	elseif: *pl '0'
!   ^^^^^^ невалидный elseif без условия
end

! кривой else if
if 0:
	else if x = 1: *pl '1'
!   ^^^^^^^ валидный else if с раздельным написанием
	else if x = 2: *pl '2'
	else if x = 3: *pl '3'
	else if x = 4: *pl '4'
	else if: *pl '5'
! ^^^^^^^^^^^^^^^^^^ вся строка невалидна из-за кривого else if
	else: *pl '0'
end

! лишний end в однострочном else
if 1:
	elseif x = 1: *pl '1'
	elseif x = 2: *pl '2'
	elseif x = 3: *pl '3'
	elseif x = 4: *pl '4'
	else: end
!         ^^^ невалидный end находится не на своём месте внутри пункта
end
--- errors_in_conditions ---------------------------------


# muliline_elseif_else
! многострочные elseif и else, простые варианты:
if 0:
	! pass
elseif x = 1:
	*pl '1'
elseif x = 2:
	*pl '2'
elseif x = 3:
	*pl '3'
elseif x = 4:
	*pl '4'
else:
	*pl '0'
end

if 0:
	! pass
else if x = 1:
!^^^^^^ раздельное написание else if
	*pl '1'
else if x = 2:
	*pl '2'
else if x = 3:
	*pl '3'
else if x = 4:
	*pl '4'
else
!^^^ else без двоеточия
	*pl '0'
end

! многострочные elseif и else с комментариями после двоеточия
if 0:
	! pass
elseif x = 1: ! первый вариант
	*pl '1' & ! этот код будет выполняться, подсвечиваем, как код
elseif x = 2: ! второй вариант
	*pl '2'
elseif x = 3: ! третий вариант
	*pl '3'
elseif x = 4: ! четвёртый вариант
	*pl '4'
else: ! вариант по умолчанию
!     ^ начало комментария (else с ':' + хвост-комментарий)
	*pl '0'
!   ^^^^^^^ обычный код, потому что сразу после else написан валидный комментарий
!           а значит это не однострочный else.
end

! вариант с комментариями после else без двоеточия
if 0:
	! pass
elseif x = 1: ! первый вариант
	*pl '1' & ! этот код будет выполняться, подсвечиваем, как код
else ! вариант по умолчанию
!    ^ начало комментария (else без ':' + хвост-комментарий)
	*pl '0'
!   ^^^^^^^ обычный код, потому что сразу после else написан валидный комментарий
end

! однострочные elseif и else, хотя и с комментариями после двоеточия
if 0:
	! pass
elseif x = 1: & ! первый вариант
	*pl '1' & ! этот код НЕ будет выполняться, подсвечиваем, как комментарий
elseif x = 2: & ! второй вариант
	*pl '2'
elseif x = 3: & ! третий вариант
	*pl '3'
elseif x = 4: & ! четвёртый вариант
	*pl '4'
else: & ! вариант по умолчанию
	*pl '0'
!   ^^^^^^^ мёртвый код однострочного else = МНОГОСТРОЧНЫЙ комментарий
end & *pl 'fffff'

! МЁРТВЫЙ РЕГИОН однострочных else/elseif — ОДИН многострочный комментарий:
! структура у него ТА ЖЕ, что у обычного `!`-комментария: "…"/'…'/{…}.
! Поэтому плеер и подсветка одинаково понимают, где регион кончается:
! `if`/`end` ВНУТРИ {…} или незакрытого литерала регион НЕ закрывают —
! выйти можно только на строке, начинающейся с end/else/elseif/if.
if 0:
	! pass
elseif x = 1: & ! первый вариант — однострочный elseif
	*pl 'мёртвый код после однострочного elseif'
	$text = 'многострочный литерал
	end
	и его хвост'
	{ ! {…} — блочная структура комментария, считает вложенность
		'end'
		{ вложенный блок
			if 1:
				*pl 'и это всё ещё комментарий'
			end
		}
	}
	*pl 'после блока — всё ещё комментарий'
else: *pl '0'
	*pl 'мёртвый код после однострочного else'
	$s = "строка с end внутри
	end
	и хвост"
end
*pl 'после end — обычный код'

! вариант с else без двоеточия
if 0:
	! pass
elseif x = 1: & ! первый вариант
	*pl '1' & ! этот код НЕ будет выполняться, подсвечиваем, как комментарий
else & ! вариант по умолчанию
	*pl '0'
!   ^^^^^^^ мёртвый код однострочного else = МНОГОСТРОЧНЫЙ комментарий (до end)
end

! то же самое, что и выше, но вместо комментария после else обычный код
if 0:
	! pass
elseif x = 1: & ! первый вариант
	*pl '1' & ! этот код НЕ будет выполняться, подсвечиваем, как комментарий
else *pl '5'
	*pl '0'
!   ^^^^^^^ мёртвый код однострочного else = МНОГОСТРОЧНЫЙ комментарий (до end)
end

! ещё вариант, после else двоеточие:
if 0:
	!pass
elseif x = 1: *pl '1'
	gosub '1' & ! команды подсвечиваются, как комментарий
else: *pl '0'
	gosub '0' & ! не будет исполнена
end


if 1:
    dynamic {
        *pl 'код' & ! "}"
        *pl 'вторая строка'
    }
end
--- muliline_elseif_else


# ends_in_conditions
! тесты end`ов и вложенных условий

! end if — только `end` подсвечивается как ключевое слово, всё после него — комментарий:
if 1:
	!pass
end if

--- ends_in_conditions ---

# includes_conditions
! вложенные условия
if 1:
	if 2:
		x = 3
	else:
		x = 4
	end
elseif x = 5: y = 9
else:
	if 0:
		new = old
	else: ! комментарий
		"Структура не ломается"
	end
end

! незакрытое условие руинит подсветку внутри фигурных скобок и/или подсветку конца локации
{
	if 1:
		else if x = 1: x
		else:
			gosub '1'
	! условие не закрыто
}
!^^^^^ вся строка со скобкой подсвечивается Invalid, потому что закрывает блок раньше, чем закрыто условие
gosub '12' & ! остальные комманды подсвечиваются нормально

--- includes_conditions ---------------------------------
!^^^^^ вся строка со скобкой подсвечивается Invalid, потому что закрывает локацию раньше, чем закрыто условие